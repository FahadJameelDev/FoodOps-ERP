@model FoodOpsERP.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Factory Overview";
}

<div class="page-header">
    <div class="page-title-row">
        <div class="page-title-icon"><i class="bi bi-building" aria-hidden="true"></i></div>
        <h1 class="page-title">Factory Overview</h1>
    </div>
    <p class="page-subtitle">Manufacturing Operations</p>
</div>

<div class="row g-3 mb-3">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="kpi-card h-100">
            <div class="kpi-header"><span class="kpi-title">Production Target Achievement</span><div class="kpi-icon kpi-emerald"><i class="bi bi-bar-chart"></i></div></div>
            <div class="kpi-value">@Model.Production.AchievementPercent.ToString("N0")%</div>
            <div class="kpi-meta">Actual: @Model.Production.Actual.ToString("N0") / @Model.Production.Target.ToString("N0") units</div>
            <div class="kpi-progress"><div class="kpi-progress-bar" style="width: @Model.Production.AchievementPercent%"></div></div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="kpi-card h-100">
            <div class="kpi-header"><span class="kpi-title">Low-stock Materials</span><div class="kpi-icon kpi-amber"><i class="bi bi-box-seam"></i></div></div>
            <div class="kpi-value">@Model.Inventory.LowStockCount.ToString("D2")</div>
            <div class="kpi-meta">Items below reorder level</div>
            <a href="/Stock/Balance" class="kpi-action action-amber">View Shortages</a>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="kpi-card h-100">
            <div class="kpi-header"><span class="kpi-title">Batches on QC Hold</span><div class="kpi-icon kpi-red"><i class="bi bi-shield-exclamation"></i></div></div>
            <div class="kpi-value">@Model.Quality.QcHoldCount.ToString("D2")</div>
            <div class="kpi-meta">Awaiting quality decision</div>
            <a href="/IncomingQC" class="kpi-action action-red">View Batches</a>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="kpi-card h-100">
            <div class="kpi-header"><span class="kpi-title">Attendance Recorded</span><div class="kpi-icon kpi-emerald"><i class="bi bi-people"></i></div></div>
            <div class="kpi-value">@Model.Attendance.PresentPercent.ToString("N0")%</div>
            <div class="kpi-meta">Present: @Model.Attendance.Present / @Model.Attendance.Total employees</div>
            <div class="kpi-progress"><div class="kpi-progress-bar" style="width: @Model.Attendance.PresentPercent%"></div></div>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-12 col-lg-8">
        <div class="card h-100">
            <div class="card-header">
                <h5 class="card-title"><i class="bi bi-bar-chart-line"></i> Production Performance</h5>
                <div class="d-flex gap-3">
                    <span class="d-flex align-items-center gap-2"><span style="width:10px;height:10px;border-radius:50%;background:#3B82F6;"></span><small class="text-muted">Planned</small></span>
                    <span class="d-flex align-items-center gap-2"><span style="width:10px;height:10px;border-radius:50%;background:#10B981;"></span><small class="text-muted">Actual</small></span>
                </div>
            </div>
            <div class="card-body p-3">
                <div class="row g-3 align-items-center">
                    <div class="col-12 col-md-7">
                        <div style="height: 240px; position: relative;"><canvas id="productionChart"></canvas></div>
                    </div>
                    <div class="col-12 col-md-5 text-center">
                        <div style="height: 200px; position: relative;"><canvas id="donutChart"></canvas></div>
                        <div class="fw-semibold mt-2" style="font-size: var(--fs-sm);">Target Achievement</div>
                        <div class="text-muted" style="font-size: var(--fs-xs);">Planned: @Model.Production.Target.ToString("N0") · Actual: @Model.Production.Actual.ToString("N0")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-4">
        <div class="card h-100">
            <div class="card-header"><h5 class="card-title"><i class="bi bi-exclamation-triangle"></i> Attention Required</h5><a href="/Dashboard/Alerts" class="btn btn-sm btn-outline-secondary">View All</a></div>
            <div class="card-body p-3">
                @if (Model.AttentionRequired.Any())
                {
                    foreach (var alert in Model.AttentionRequired)
                    {
                        var alertClass = alert.Severity switch { "Critical" => "alert-item-danger", "Warning" => "alert-item-warning", _ => "alert-item-info" };
                        var iconClass = alert.Severity switch { "Critical" => "bi-exclamation-circle", "Warning" => "bi-exclamation-triangle", _ => "bi-info-circle" };
                        <div class="alert-item @alertClass">
                            <div class="alert-item-icon"><i class="bi @iconClass"></i></div>
                            <div class="alert-item-content">
                                <div class="alert-item-title">@alert.Title</div>
                                <div class="alert-item-desc">@alert.Description</div>
                                <div class="alert-item-time">@alert.TimeAgo</div>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <a href="@alert.ActionUrl" class="alert-item-action">@alert.ActionText</a>
                                <i class="bi bi-chevron-right text-muted" style="font-size:10px;"></i>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted text-center py-3">No alerts found.</p>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-12 col-lg-8">
        <div class="card h-100">
            <div class="card-header"><h5 class="card-title"><i class="bi bi-boxes"></i> Active Production Batches</h5><a href="/ProductionOrders" class="btn btn-sm btn-outline-secondary">View All</a></div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr><th>Batch #</th><th>Product</th><th>Stage</th><th>Progress</th><th>Status</th><th class="text-end">Actions</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var batch in Model.ActiveBatches)
                            {
                                <tr>
                                    <td><strong>@batch.BatchNumber</strong></td>
                                    <td><i class="bi @batch.ProductIcon me-2 text-success"></i>@batch.ProductName</td>
                                    <td>@batch.Stage</td>
                                    <td style="min-width: 120px;">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="kpi-progress flex-grow-1" style="margin: 0;"><div class="kpi-progress-bar" style="width: @batch.Progress%"></div></div>
                                            <small class="text-muted">@batch.Progress%</small>
                                        </div>
                                    </td>
                                    <td><span class="badge @batch.StatusBadgeClass">@batch.Status</span></td>
                                    <td class="text-end">
                                        <!-- ✅ FIX: batch.Id use kiya -->
                                        <a href="/ProductionOrders/Details/@batch.Id" class="btn btn-sm btn-outline-secondary">View</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-4">
        <div class="card h-100">
            <div class="card-header"><h5 class="card-title"><i class="bi bi-stars text-ai"></i> FoodOps AI Assistant <span class="badge bg-info ms-2">Beta</span></h5><a href="/AIAssistant" class="btn btn-sm btn-outline-secondary">View Insights</a></div>
            <div class="card-body p-3 d-flex flex-column justify-content-between">
                <div class="mb-2 d-flex align-items-start gap-2">
                    <div class="user-avatar" style="background: linear-gradient(135deg, #8B5CF6 0%, #7C3AED 100%);"><i class="bi bi-robot"></i></div>
                    <div>
                        <div class="fw-semibold">How can I help you today?</div>
                        <small class="text-muted">Ask about production, inventory, quality, cost or workforce data.</small>
                    </div>
                </div>
                <div class="mb-2">
                    <a href="/AIAssistant/Production" class="btn btn-sm btn-outline-secondary me-1 mb-1">Why did target fall short?</a>
                    <a href="/AIAssistant/Inventory" class="btn btn-sm btn-outline-secondary me-1 mb-1">Which materials are low?</a>
                    <a href="/AIAssistant/Quality" class="btn btn-sm btn-outline-secondary me-1 mb-1">Show QC holds.</a>
                    <a href="/AIAssistant/Payroll" class="btn btn-sm btn-outline-secondary me-1 mb-1">Attendance rate?</a>
                </div>
                <form asp-controller="AIAssistant" asp-action="Index" method="get" class="position-relative mt-2">
                    <input type="text" name="q" class="form-control form-control-sm pe-5" placeholder="Ask a question..." />
                    <button type="submit" class="btn btn-primary btn-sm" style="position: absolute; right: 3px; top: 3px; padding: 2px 8px;"><i class="bi bi-send"></i></button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="text-muted text-end mt-2" style="font-size: 10px;">Live data from database</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
        const labels  = @Html.Raw(Model.ProductionChart.LabelsJson);
        const planned = @Html.Raw(Model.ProductionChart.PlannedJson);
        const actual  = @Html.Raw(Model.ProductionChart.ActualJson);
        const achievement = @Model.Production.AchievementPercent;

        const ctx = document.getElementById('productionChart');
        if (ctx) {
        new Chart(ctx, {
        type: 'bar',
        data: {
        labels: labels,
        datasets: [
        { label: 'Planned', data: planned, backgroundColor: '#3B82F6', borderRadius: 4, barThickness: 24 },
        { label: 'Actual',  data: actual,  backgroundColor: '#10B981', borderRadius: 4, barThickness: 24 }
        ]
        },
        options: {
        responsive: true, maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
        y: { beginAtZero: true, grid: { color: '#F1F5F9' }, ticks: { color: '#64748B', font: { size: 10 } } },
        x: { grid: { display: false }, ticks: { color: '#64748B', font: { size: 10 } } }
        }
        }
        });
        }

        const dctx = document.getElementById('donutChart');
        if (dctx) {
        new Chart(dctx, {
        type: 'doughnut',
        data: { datasets: [{ data: [achievement, 100 - achievement], backgroundColor: ['#10B981', '#E5E7EB'], borderWidth: 0, cutout: '75%' }] },
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false }, tooltip: { enabled: false } } },
        plugins: [{
        id: 'centerText',
        afterDraw(chart) {
        const { ctx, chartArea } = chart;
        const centerX = (chartArea.left + chartArea.right) / 2;
        const centerY = (chartArea.top + chartArea.bottom) / 2;
        ctx.save(); ctx.font = 'bold 24px Inter, sans-serif'; ctx.fillStyle = '#0F172A';
        ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
        ctx.fillText(achievement.toFixed(0) + '%', centerX, centerY);
        ctx.restore();
        }
        }]
        });
        }
        });
    </script>
}