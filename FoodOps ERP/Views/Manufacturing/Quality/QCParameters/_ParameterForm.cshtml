@model FoodOpsERP.Models.Manufacturing.Quality.ViewModels.QCParameterViewModel
@{
    var isEdit = Model.ParameterID != 0;
    var uoms = ViewData["UOMs"] as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new();
}

<form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@(isEdit ? Model.ParameterID.ToString() : null)"
      method="post" data-spa-form data-reload-url="@Url.Action("Index")" data-refresh="#grid-card" novalidate>
    
    <div class="fo-modal__body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        @if (isEdit)
        {
            <input type="hidden" asp-for="ParameterID" />
        }

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="ParameterCode" class="form-label">Parameter Code <span class="text-danger">*</span></label>
                <input asp-for="ParameterCode" class="form-control" placeholder="e.g., PH" readonly="@isEdit" />
                <span asp-validation-for="ParameterCode" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="ParameterName" class="form-label">Parameter Name <span class="text-danger">*</span></label>
                <input asp-for="ParameterName" class="form-control" placeholder="e.g., pH Level" />
                <span asp-validation-for="ParameterName" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="ParameterType" class="form-label">Parameter Type <span class="text-danger">*</span></label>
                <select asp-for="ParameterType" class="form-select" required>
                    <option value="Numeric">Numeric</option>
                    <option value="PassFail">Pass / Fail</option>
                    <option value="Text">Text</option>
                </select>
                <span asp-validation-for="ParameterType" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="DefaultUOMID" class="form-label">Default UOM (Optional)</label>
                <select asp-for="DefaultUOMID" asp-items="uoms" class="form-select">
                    <option value="">-- None --</option>
                </select>
            </div>

            <div class="col-12 mt-3">
                <div class="form-check">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label">Is Active</label>
                </div>
            </div>
        </div>
    </div>

    <div class="fo-modal__footer">
        <button type="button" class="btn btn-outline-secondary" data-modal-close>Cancel</button>
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i><span>@(isEdit ? "Update Parameter" : "Save Parameter")</span></button>
    </div>
</form>