@model FoodOpsERP.Models.Manufacturing.ProductsAndRecipes.ViewModels.RecipeViewModel
@{
    ViewData["Title"] = $"Recipe: {Model.RecipeCode}";
    ViewData["Subtitle"] = $"Version {Model.VersionNo} • Status: {Model.Status}";
}

<style>
    /* ✅ MICROSOFT FLUENT - PREMIUM RECIPE DETAILS (FULL WIDTH) */
    .page-content { padding: 12px var(--content-x) 12px var(--content-x) !important; }

    .recipe-dashboard {
        display: flex;
        flex-direction: column;
        gap: 12px;
        height: calc(100vh - 140px);
    }

    /* Premium Header */
    .recipe-header-card {
        display: flex; align-items: center; justify-content: space-between;
        background: #ffffff; border: 1px solid var(--border);
        border-radius: var(--radius-card); padding: 12px 16px; flex-shrink: 0;
    }
    .header-icon { display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; background: #ECFDF5; color: var(--emerald-dark); border-radius: 8px; font-size: 18px; }
    .header-title { font-size: 18px; font-weight: 700; color: var(--text-heading); margin: 0; line-height: 1.2; }
    .header-subtitle { font-size: 11px; color: var(--text-muted); margin: 0; }

    /* Info Grid (Full Width) */
    .info-card {
        background: #fff; border: 1px solid var(--border); border-radius: var(--radius-card);
        padding: 16px; flex-shrink: 0;
    }
    .info-grid {
        display: grid; grid-template-columns: repeat(6, 1fr); gap: 16px;
    }
    .info-label { font-size: 11px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.03em; margin-bottom: 4px; display: block; }
    .info-value { font-size: 14px; font-weight: 600; color: var(--text-heading); }
    
    .change-summary {
        background: #FFFBEB; border: 1px solid #FDE68A; border-radius: 8px; padding: 12px; margin-top: 16px;
        font-size: 13px; color: #B45309;
    }

    /* Table Card (Full Width) */
    .table-card {
        flex: 1;
        background: #fff; border: 1px solid var(--border); border-radius: var(--radius-card);
        display: flex; flex-direction: column; overflow: hidden; min-height: 0;
    }
    .table-card-header {
        padding: 12px 16px; border-bottom: 1px solid var(--divider); flex-shrink: 0;
        display: flex; align-items: center; justify-content: space-between;
    }
    .table-card-title { font-size: 15px; font-weight: 600; color: var(--text-heading); margin: 0; display: flex; align-items: center; gap: 8px; }

    .table-body-scroll { flex: 1; overflow-y: auto; min-height: 0; }
    .premium-table { width: 100%; border-collapse: separate; border-spacing: 0; margin: 0; }
    .premium-table th {
        background: var(--surface-2); color: var(--text-muted); font-size: 11px; font-weight: 600;
        text-transform: uppercase; letter-spacing: 0.05em; padding: 12px 16px;
        text-align: left; border-bottom: 1px solid var(--line); position: sticky; top: 0; z-index: 2;
    }
    .premium-table td {
        padding: 12px 16px; font-size: 13px; color: var(--text-body);
        border-bottom: 1px solid var(--divider); vertical-align: middle;
    }
    .premium-table tr:last-child td { border-bottom: none; }
    .premium-table tr:hover td { background: var(--surface-2); }

    /* ✅ Bottom History Bar (Replaces Right Column) */
    .history-bar {
        display: flex; align-items: center; gap: 24px;
        background: #fff; border: 1px solid var(--border); border-radius: var(--radius-card);
        padding: 12px 16px; flex-shrink: 0;
    }
    .history-item { display: flex; flex-direction: column; gap: 2px; }
    .history-label { font-size: 10px; color: var(--text-muted); text-transform: uppercase; font-weight: 600; }
    .history-value { font-size: 12px; font-weight: 600; color: var(--text-heading); }
</style>

<div class="recipe-dashboard">
    <!-- 1. PREMIUM HEADER -->
    <div class="recipe-header-card">
        <div class="d-flex align-items-center gap-3">
            <div class="header-icon"><i class="bi bi-journal-text"></i></div>
            <div>
                <h1 class="header-title">Recipe: @Model.RecipeCode <partial name="_StatusPill" model="Model.Status" /></h1>
                <p class="header-subtitle">Version @Model.VersionNo • @Model.ProductName</p>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm py-2 px-3" style="font-size: 12px;">
                <i class="bi bi-arrow-left me-1"></i> Back
            </a>
            @if (Model.Status == "Draft" || Model.Status == "Rejected")
            {
                <a asp-action="Edit" asp-route-id="@Model.RecipeID" class="btn btn-outline-primary btn-sm py-2 px-3" style="font-size: 12px;" data-modal="true" data-modal-title="Edit Recipe" data-modal-size="lg">
                    <i class="bi bi-pencil me-1"></i> Edit
                </a>
                <button type="button" class="btn btn-primary btn-sm py-2 px-3" style="font-size: 12px;" data-action-url="/Recipes/SubmitForApproval?id=@Model.RecipeID" data-confirm-title="Submit for approval?" data-confirm-text="Submit" data-refresh="#grid-card">
                    <i class="bi bi-send me-1"></i> Submit
                </button>
            }
            @if (Model.Status == "Approved" && !Model.IsCurrent)
            {
                <button type="button" class="btn btn-warning btn-sm py-2 px-3 text-dark" style="font-size: 12px;" data-action-url="/Recipes/SetCurrent?id=@Model.RecipeID" data-confirm-title="Set as current version?" data-confirm-text="Set Current" data-refresh="#grid-card">
                    <i class="bi bi-star me-1"></i> Set Current
                </button>
            }
        </div>
    </div>

    <!-- 2. INFO GRID (Full Width) -->
    <div class="info-card">
        <div class="info-grid">
            <div>
                <span class="info-label">Product</span>
                <span class="info-value">@Model.ProductName</span>
            </div>
            <div>
                <span class="info-label">Batch Size</span>
                <span class="info-value">@Model.StandardBatchSize @Model.BatchUOMName</span>
            </div>
            <div>
                <span class="info-label">Yield</span>
                <span class="info-value">@Model.YieldPercentage %</span>
            </div>
            <div>
                <span class="info-label">Effective From</span>
                <span class="info-value">@(Model.EffectiveFrom?.ToString("dd MMM yyyy") ?? "N/A")</span>
            </div>
            <div>
                <span class="info-label">Effective To</span>
                <span class="info-value">@(Model.EffectiveTo?.ToString("dd MMM yyyy") ?? "N/A")</span>
            </div>
            <div>
                <span class="info-label">Current</span>
                <span class="info-value">@(Model.IsCurrent ? "Yes" : "No")</span>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(Model.ChangeSummary))
        {
            <div class="change-summary">
                <strong>Change Summary:</strong> @Model.ChangeSummary
            </div>
        }
    </div>

    <!-- 3. INGREDIENTS TABLE (Full Width) -->
    <div class="table-card">
        <div class="table-card-header">
            <h5 class="table-card-title"><i class="bi bi-list-check"></i> Ingredients</h5>
            <span class="badge bg-surface-2 text-muted border px-3 py-2" style="font-size: 12px; border-radius: 6px;">
                @(Model.Items?.Count ?? 0) Items
            </span>
        </div>
        <div class="table-body-scroll">
            <table class="premium-table">
                <thead>
                    <tr>
                        <th style="width: 50px;">#</th>
                        <th>Ingredient</th>
                        <th class="text-end">Qty</th>
                        <th>UOM</th>
                        <th class="text-end">Scrap %</th>
                        <th>Critical</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@item.LineNo</td>
                                <td><strong>@item.IngredientName</strong></td>
                                <td class="text-end">@item.RequiredQty</td>
                                <td>@item.UOMName</td>
                                <td class="text-end">@item.ScrapPercent %</td>
                                <td>
                                    @if (item.IsCritical)
                                    {
                                        <span class="badge" style="background:#FEF2F2; color:#DC2626;">Yes</span>
                                    }
                                    else
                                    {
                                        <span class="badge" style="background:#F1F5F9; color:#64748B;">No</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">No ingredients added yet.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- ✅ 4. BOTTOM HISTORY BAR (Replaces right column) -->
    <div class="history-bar">
        <i class="bi bi-clock-history text-muted" style="font-size: 20px;"></i>
        <div class="history-item">
            <span class="history-label">Created At</span>
            <span class="history-value">@Model.CreatedAt.ToString("dd MMM yyyy, HH:mm")</span>
        </div>
        @if (Model.ApprovedAt.HasValue)
        {
            <div class="history-item">
                <span class="history-label">Approved At</span>
                <span class="history-value">@Model.ApprovedAt.Value.ToString("dd MMM yyyy, HH:mm")</span>
            </div>
        }
        <div class="history-item">
            <span class="history-label">Version</span>
            <span class="history-value">v@Model.VersionNo</span>
        </div>
        <div class="history-item ms-auto">
            <span class="history-label">Status</span>
            <partial name="_StatusPill" model="Model.Status" />
        </div>
    </div>
</div>