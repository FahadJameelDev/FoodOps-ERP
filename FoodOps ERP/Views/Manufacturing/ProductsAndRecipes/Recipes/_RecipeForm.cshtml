@model FoodOpsERP.Models.Manufacturing.ProductsAndRecipes.ViewModels.RecipeViewModel
@{
    var isEdit = Model.RecipeID != 0;
    var products = ViewData["Products"] as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
    var uoms = ViewData["UOMs"] as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
    var rows = Model.Items?.Count ?? 0;

    // Naya Ingredient Row banane ka template
    Func<string, object> blankRow = @<div class="repeater-row">
        <input type="hidden" name="Items.Index" value="@item" />
        
        <select name="Items[@item].IngredientProductID" class="form-select" required>
            <option value="">Select Ingredient...</option>
            @foreach (var p in products)
            {
                <option value="@p.Value">@p.Text</option>
            }
        </select>
        
        <select name="Items[@item].UOMID" class="form-select" required>
            <option value="">UOM</option>
            @foreach (var u in uoms)
            {
                <option value="@u.Value">@u.Text</option>
            }
        </select>
        
        <input name="Items[@item].RequiredQty" type="number" step="0.0001" min="0.0001" class="form-control num" data-qty placeholder="Qty" required />
        <input name="Items[@item].ScrapPercent" type="number" step="0.01" min="0" max="100" class="form-control num" placeholder="Scrap %" value="0" />
        
        <div class="form-check d-flex justify-content-center align-items-center mb-0" title="Critical Ingredient?">
            <input type="hidden" name="Items[@item].IsCritical" value="false" />
            <input name="Items[@item].IsCritical" type="checkbox" class="form-check-input" value="true" />
        </div>
        
        <button type="button" class="btn-icon text-danger" data-repeater-remove title="Remove"><i class="bi bi-x-lg"></i></button>
    </div>;
}

<form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@(isEdit ? Model.RecipeID.ToString() : null)"
      method="post" data-spa-form data-reload-url="@Url.Action("Index")" data-refresh="#grid-card" novalidate>
    
    <div class="fo-modal__body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        @if (isEdit)
        {
            <input type="hidden" asp-for="RecipeID" />
        }

        <div class="row g-3 mb-4">
            <!-- Product Dropdown -->
            <div class="col-md-6">
                <label asp-for="ProductID" class="form-label">Product <span class="text-danger">*</span></label>
                <select asp-for="ProductID" asp-items="products" class="form-select" required>
                    <option value="">Select Product...</option>
                </select>
                <span asp-validation-for="ProductID" class="text-danger"></span>
            </div>

            <!-- Recipe Code -->
            <div class="col-md-3">
                <label asp-for="RecipeCode" class="form-label">Recipe Code <span class="text-danger">*</span></label>
                <input asp-for="RecipeCode" class="form-control" placeholder="e.g., REC-001" />
                <span asp-validation-for="RecipeCode" class="text-danger"></span>
            </div>

            <!-- Version No -->
            <div class="col-md-3">
                <label asp-for="VersionNo" class="form-label">Version</label>
                <input asp-for="VersionNo" class="form-control" readonly />
            </div>

            <!-- Batch Size -->
            <div class="col-md-4">
                <label asp-for="StandardBatchSize" class="form-label">Batch Size <span class="text-danger">*</span></label>
                <input asp-for="StandardBatchSize" type="number" step="0.0001" class="form-control num" />
                <span asp-validation-for="StandardBatchSize" class="text-danger"></span>
            </div>

            <!-- UOM Dropdown -->
            <div class="col-md-4">
                <label asp-for="BatchUOMID" class="form-label">Batch UOM <span class="text-danger">*</span></label>
                <select asp-for="BatchUOMID" asp-items="uoms" class="form-select" required>
                    <option value="">Select UOM...</option>
                </select>
                <span asp-validation-for="BatchUOMID" class="text-danger"></span>
            </div>

            <!-- Yield % -->
            <div class="col-md-4">
                <label asp-for="YieldPercentage" class="form-label">Yield % <span class="text-danger">*</span></label>
                <input asp-for="YieldPercentage" type="number" step="0.01" class="form-control num" />
                <span asp-validation-for="YieldPercentage" class="text-danger"></span>
            </div>

            <!-- Dates -->
            <div class="col-md-6">
                <label asp-for="EffectiveFrom" class="form-label">Effective From</label>
                <input asp-for="EffectiveFrom" type="date" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="EffectiveTo" class="form-label">Effective To</label>
                <input asp-for="EffectiveTo" type="date" class="form-control" />
            </div>

            <div class="col-12">
                <label asp-for="ChangeSummary" class="form-label">Change Summary</label>
                <textarea asp-for="ChangeSummary" class="form-control" rows="2" placeholder="Reason for change..."></textarea>
            </div>
        </div>

        <hr />
        <h6 class="mb-3">Recipe Ingredients</h6>
        
        <!-- Repeater Box -->
        <div data-repeater id="recipe-items" data-next="@Math.Max(rows, 1)">
            
            <!-- Repeater Header -->
            <div class="repeater-head" style="display: grid; grid-template-columns: 3fr 1fr 1fr 1fr 50px 40px; gap: 8px; margin-bottom: 5px; font-size: 12px; font-weight: 600; color: #64748B;">
                <span>Ingredient</span>
                <span>UOM</span>
                <span class="num">Qty</span>
                <span class="num">Scrap %</span>
                <span class="text-center" title="Critical (Allergen/CCP)">Crit.</span>
                <span></span>
            </div>

            <!-- Existing Rows -->
            <div class="repeater-rows">
                @for (var i = 0; i < rows; i++)
                {
                    <div class="repeater-row" style="display: grid; grid-template-columns: 3fr 1fr 1fr 1fr 50px 40px; gap: 8px; margin-bottom: 8px; align-items: center;">
                        <input type="hidden" name="Items.Index" value="@i" />
                        
                        <div>
                            <select asp-for="Items[i].IngredientProductID" asp-items="products" class="form-select form-select-sm">
                                <option value="">Select...</option>
                            </select>
                            <span asp-validation-for="Items[i].IngredientProductID" class="text-danger fs-xs"></span>
                        </div>
                        
                        <div>
                            <select asp-for="Items[i].UOMID" asp-items="uoms" class="form-select form-select-sm">
                                <option value="">UOM</option>
                            </select>
                        </div>
                        
                        <div><input asp-for="Items[i].RequiredQty" type="number" step="0.0001" class="form-control form-control-sm num" data-qty /></div>
                        
                        <div><input asp-for="Items[i].ScrapPercent" type="number" step="0.01" class="form-control form-control-sm num" /></div>
                        
                        <div class="form-check d-flex justify-content-center mb-0">
                            <input type="hidden" name="Items[@i].IsCritical" value="false" />
                            <input asp-for="Items[i].IsCritical" type="checkbox" class="form-check-input" value="true" />
                        </div>
                        
                        <button type="button" class="btn-icon text-danger" data-repeater-remove><i class="bi bi-x-lg"></i></button>
                    </div>
                }
                @if (rows == 0)
                {
                    @blankRow("0")
                }
            </div>

            <!-- JS Template (Hidden) -->
            <template>@blankRow("__i__")</template>

            <div class="repeater-foot mt-3">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-repeater-add="#recipe-items">
                    <i class="bi bi-plus-lg"></i> Add Ingredient
                </button>
            </div>
        </div>
    </div>

    <div class="fo-modal__footer">
        <button type="button" class="btn btn-outline-secondary" data-modal-close>Cancel</button>
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i><span>@(isEdit ? "Update Recipe" : "Create Recipe")</span></button>
    </div>
</form>