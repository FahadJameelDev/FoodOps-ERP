@model FoodOpsERP.Models.Manufacturing.ProductsAndRecipes.ViewModels.RecipeChangeRequestViewModel
@{
    var recipes = ViewData["Recipes"] as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new();
}

<form asp-action="Create" method="post" data-spa-form data-reload-url="@Url.Action("Index")" data-refresh="#grid-card" novalidate>
    
    <div class="fo-modal__body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <input type="hidden" asp-for="RecipeID" />

        <div class="row g-3">
            <div class="col-md-12">
                <label asp-for="RecipeID" class="form-label">Recipe <span class="text-danger">*</span></label>
                <!-- FIX: asp-items lagaya -->
                <select asp-for="RecipeID" asp-items="recipes" class="form-select" required>
                    <option value="">Select Approved Recipe...</option>
                </select>
                <span asp-validation-for="RecipeID" class="text-danger"></span>
                <div class="form-hint">Note: Only approved recipes can be changed.</div>
            </div>

            <div class="col-md-12">
                <label asp-for="ChangeType" class="form-label">Change Type <span class="text-danger">*</span></label>
                <select asp-for="ChangeType" class="form-select" required>
                    <option value="Ingredient">Ingredient Change</option>
                    <option value="Quantity">Quantity Change</option>
                    <option value="Process">Process Change</option>
                    <option value="Supplier">Supplier Change</option>
                    <option value="Regulatory">Regulatory Change</option>
                    <option value="Other">Other</option>
                </select>
                <span asp-validation-for="ChangeType" class="text-danger"></span>
            </div>

            <div class="col-md-12">
                <label asp-for="Reason" class="form-label">Reason for Change <span class="text-danger">*</span></label>
                <textarea asp-for="Reason" class="form-control" rows="3" placeholder="Why is this change required?" required></textarea>
                <span asp-validation-for="Reason" class="text-danger"></span>
            </div>

            <div class="col-md-12">
                <label asp-for="ImpactAssessment" class="form-label">Impact Assessment</label>
                <textarea asp-for="ImpactAssessment" class="form-control" rows="3" placeholder="What will be the impact on product, cost, or process?"></textarea>
                <span asp-validation-for="ImpactAssessment" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="fo-modal__footer">
        <button type="button" class="btn btn-outline-secondary" data-modal-close>Cancel</button>
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i><span>Submit Request</span></button>
    </div>
</form>