@model FoodOpsERP.Models.Manufacturing.ProductsAndRecipes.ViewModels.PackagingConfigViewModel
@{
    var isEdit = Model.PackagingConfigID != 0;
}

<form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@(isEdit ? Model.PackagingConfigID.ToString() : null)"
      method="post" data-spa-form data-reload-url="@Url.Action("Index")" data-refresh="#grid-card" novalidate>
    
    <div class="fo-modal__body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        @if (isEdit)
        {
            <input type="hidden" asp-for="PackagingConfigID" />
        }

        <div class="row g-3">
            <div class="col-md-12">
                <label asp-for="ProductID" class="form-label">Product <span class="text-danger">*</span></label>
                <!-- ✅ Updated: asp-items Model se -->
                <select asp-for="ProductID" asp-items="Model.ProductList" class="form-select" required>
                    <option value="">Select Product...</option>
                </select>
                <span asp-validation-for="ProductID" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="PackageType" class="form-label">Package Type <span class="text-danger">*</span></label>
                <input asp-for="PackageType" class="form-control" placeholder="e.g., Box, Bottle" />
                <span asp-validation-for="PackageType" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="PackageName" class="form-label">Package Name <span class="text-danger">*</span></label>
                <input asp-for="PackageName" class="form-control" placeholder="e.g., 500ml Bottle" />
                <span asp-validation-for="PackageName" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="UnitsPerPack" class="form-label">Units Per Pack <span class="text-danger">*</span></label>
                <input asp-for="UnitsPerPack" type="number" class="form-control" />
                <span asp-validation-for="UnitsPerPack" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="NetWeight" class="form-label">Net Weight <span class="text-danger">*</span></label>
                <input asp-for="NetWeight" type="number" step="0.0001" class="form-control num" />
                <span asp-validation-for="NetWeight" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="GrossWeight" class="form-label">Gross Weight <span class="text-danger">*</span></label>
                <input asp-for="GrossWeight" type="number" step="0.0001" class="form-control num" />
                <span asp-validation-for="GrossWeight" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="WeightUOMID" class="form-label">UOM <span class="text-danger">*</span></label>
                <!-- ✅ Updated: asp-items Model se -->
                <select asp-for="WeightUOMID" asp-items="Model.UOMList" class="form-select" required>
                    <option value="">Select UOM...</option>
                </select>
                <span asp-validation-for="WeightUOMID" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Barcode" class="form-label">Barcode</label>
                <input asp-for="Barcode" class="form-control" />
            </div>

            <div class="col-md-6">
                <div class="form-check mt-3">
                    <input asp-for="IsDefault" class="form-check-input" />
                    <label asp-for="IsDefault" class="form-check-label">Is Default Packaging</label>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-check mt-3">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label">Is Active</label>
                </div>
            </div>
        </div>
    </div>

    <div class="fo-modal__footer">
        <button type="button" class="btn btn-outline-secondary" data-modal-close>Cancel</button>
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i><span>@(isEdit ? "Update Config" : "Save Config")</span></button>
    </div>
</form>