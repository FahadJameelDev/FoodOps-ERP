@model FoodOpsERP.Models.Manufacturing.Production.ViewModels.DemandViewModel
@{
    var isEdit = Model.DemandID != 0;
}

<form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@(isEdit ? Model.DemandID.ToString() : null)"
      method="post" data-spa-form data-reload-url="@Url.Action("Index")" data-refresh="#grid-card" novalidate>

    <div class="fo-modal__body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        @if (isEdit)
        {
            <input type="hidden" asp-for="DemandID" />
        }

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="PlantID" class="form-label">Plant <span class="text-danger">*</span></label>
                <select asp-for="PlantID" asp-items="Model.PlantList" class="form-select" required>
                    <option value="">Select Plant...</option>
                </select>
                <span asp-validation-for="PlantID" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="ProductID" class="form-label">Product <span class="text-danger">*</span></label>
                <select asp-for="ProductID" asp-items="Model.ProductList" class="form-select" required>
                    <option value="">Select Product...</option>
                </select>
                <span asp-validation-for="ProductID" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="RequiredDate" class="form-label">Required Date <span class="text-danger">*</span></label>
                <input asp-for="RequiredDate" class="form-control" type="date" />
                <span asp-validation-for="RequiredDate" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Quantity" class="form-label">Quantity <span class="text-danger">*</span></label>
                <input asp-for="Quantity" class="form-control num" type="number" step="0.0001" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="UOMID" class="form-label">UOM <span class="text-danger">*</span></label>
                <select asp-for="UOMID" asp-items="Model.UOMList" class="form-select" required>
                    <option value="">Select UOM...</option>
                </select>
                <span asp-validation-for="UOMID" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Source" class="form-label">Source <span class="text-danger">*</span></label>
                <select asp-for="Source" asp-items="Model.SourceList" class="form-select" required></select>
                <span asp-validation-for="Source" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Priority" class="form-label">Priority</label>
                <select asp-for="Priority" class="form-select">
                    <option value="1">1 - Critical</option>
                    <option value="2">2 - High</option>
                    <option value="3">3 - Medium</option>
                    <option value="4">4 - Low</option>
                    <option value="5">5 - Very Low</option>
                </select>
            </div>

            <div class="col-md-4">
                <label asp-for="ReferenceNo" class="form-label">Reference No</label>
                <input asp-for="ReferenceNo" class="form-control" />
            </div>

            <div class="col-12">
                <label asp-for="Notes" class="form-label">Notes</label>
                <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
            </div>
        </div>
    </div>

    <div class="fo-modal__footer">
        <button type="button" class="btn btn-outline-secondary" data-modal-close>Cancel</button>
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i><span>@(isEdit ? "Update Demand" : "Save Demand")</span></button>
    </div>
</form>