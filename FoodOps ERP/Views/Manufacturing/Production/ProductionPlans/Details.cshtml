@model FoodOpsERP.Models.Manufacturing.Production.ViewModels.ProductionPlanViewModel
@{
    ViewData["Title"] = $"Plan {Model.PlanCode}";
    ViewData["Subtitle"] = "Production Plan Details";
    bool isDraft = Model.Status == "Draft";
    bool isApproved = Model.Status == "Approved";
    bool isReleased = Model.Status == "Released";
}

<style>
    .page-content { padding: 12px var(--content-x) 12px var(--content-x) !important; }
    .plan-dashboard { display: flex; flex-direction: column; gap: 12px; height: calc(100vh - 140px); }

    /* Header */
    .plan-header-card {
        display: flex; align-items: center; justify-content: space-between;
        background: #fff; border: 1px solid var(--border);
        border-radius: var(--radius-card); padding: 12px 16px; flex-shrink: 0;
    }
    .header-icon { display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; background: #EFF6FF; color: #2563EB; border-radius: 8px; font-size: 18px; }
    .header-title { font-size: 18px; font-weight: 700; color: var(--text-heading); margin: 0; line-height: 1.2; }
    .header-subtitle { font-size: 11px; color: var(--text-muted); margin: 0; }

    /* Info Grid */
    .info-card { background: #fff; border: 1px solid var(--border); border-radius: var(--radius-card); padding: 16px; flex-shrink: 0; }
    .info-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
    .info-label { font-size: 11px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.03em; margin-bottom: 4px; display: block; }
    .info-value { font-size: 14px; font-weight: 600; color: var(--text-heading); }

    /* Table Card */
    .table-card { flex: 1; background: #fff; border: 1px solid var(--border); border-radius: var(--radius-card); display: flex; flex-direction: column; overflow: hidden; min-height: 0; }
    .table-card-header { padding: 12px 16px; border-bottom: 1px solid var(--divider); flex-shrink: 0; display: flex; align-items: center; justify-content: space-between; }
    .table-card-title { font-size: 15px; font-weight: 600; color: var(--text-heading); margin: 0; display: flex; align-items: center; gap: 8px; }
    .table-body-scroll { flex: 1; overflow-y: auto; min-height: 0; }

    .premium-table { width: 100%; border-collapse: separate; border-spacing: 0; margin: 0; }
    .premium-table th { background: var(--surface-2); color: var(--text-muted); font-size: 11px; font-weight: 600; text-transform: uppercase; padding: 12px 16px; text-align: left; border-bottom: 1px solid var(--line); position: sticky; top: 0; z-index: 2; }
    .premium-table td { padding: 12px 16px; font-size: 13px; color: var(--text-body); border-bottom: 1px solid var(--divider); vertical-align: middle; }
    .premium-table tr:last-child td { border-bottom: none; }
    .premium-table tr:hover td { background: var(--surface-2); }

    /* Bottom History Bar */
    .history-bar { display: flex; align-items: center; gap: 24px; background: #fff; border: 1px solid var(--border); border-radius: var(--radius-card); padding: 12px 16px; flex-shrink: 0; }
    .history-item { display: flex; flex-direction: column; gap: 2px; }
    .history-label { font-size: 10px; color: var(--text-muted); text-transform: uppercase; font-weight: 600; }
    .history-value { font-size: 12px; font-weight: 600; color: var(--text-heading); }
</style>

<div class="plan-dashboard">
    <!-- Header -->
    <div class="plan-header-card">
        <div class="d-flex align-items-center gap-3">
            <div class="header-icon"><i class="bi bi-diagram-3"></i></div>
            <div>
                <h1 class="header-title">Plan @Model.PlanCode <partial name="_StatusPill" model="Model.Status" /></h1>
                <p class="header-subtitle">Production Plan</p>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm py-2 px-3" style="font-size: 12px;"><i class="bi bi-arrow-left me-1"></i> Back</a>
            @if (isDraft) { <button type="button" class="btn btn-success btn-sm py-2 px-3" style="font-size: 12px;" data-action-url="@Url.Action("Approve", new { id = Model.PlanID })" data-confirm-title="Approve Plan?" data-confirm-text="Approve" data-reload-url="@Url.Action("Details", new { id = Model.PlanID })"><i class="bi bi-check2-circle me-1"></i>Approve</button> }
            @if (isApproved) { <button type="button" class="btn btn-primary btn-sm py-2 px-3" style="font-size: 12px;" data-action-url="@Url.Action("Release", new { id = Model.PlanID })" data-confirm-title="Release Plan?" data-confirm-text="Release" data-reload-url="@Url.Action("Details", new { id = Model.PlanID })"><i class="bi bi-box-arrow-up me-1"></i>Release</button> }
            @if (isReleased) { <button type="button" class="btn btn-secondary btn-sm py-2 px-3" style="font-size: 12px;" data-action-url="@Url.Action("Close", new { id = Model.PlanID })" data-confirm-title="Close Plan?" data-confirm-text="Close" data-reload-url="@Url.Action("Details", new { id = Model.PlanID })"><i class="bi bi-lock me-1"></i>Close</button> }
            @if (Model.Status != "Closed" && Model.Status != "Cancelled") { <button type="button" class="btn btn-outline-danger btn-sm py-2 px-3" style="font-size: 12px;" data-action-url="@Url.Action("Cancel", new { id = Model.PlanID })" data-confirm-title="Cancel Plan?" data-confirm-text="Cancel" data-reload-url="@Url.Action("Details", new { id = Model.PlanID })"><i class="bi bi-x-circle me-1"></i>Cancel</button> }
        </div>
    </div>

    <!-- Info Grid -->
    <div class="info-card">
        <div class="info-grid">
            <div>
                <span class="info-label">Plant</span>
                <span class="info-value">@Model.PlantName</span>
            </div>
            <div>
                <span class="info-label">Start Date</span>
                <span class="info-value">@Model.StartDate.ToString("dd MMM yyyy")</span>
            </div>
            <div>
                <span class="info-label">End Date</span>
                <span class="info-value">@Model.EndDate.ToString("dd MMM yyyy")</span>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(Model.Notes))
        {
            <div class="mt-3 p-2" style="background: #F8FAFC; border-radius: 6px; font-size: 13px; color: #64748B;">
                <i class="bi bi-sticky me-2"></i>@Model.Notes
            </div>
        }
    </div>

    <!-- Table Card -->
    <div class="table-card">
        <div class="table-card-header">
            <h5 class="table-card-title"><i class="bi bi-list-check"></i> Plan Lines</h5>
            <span class="badge bg-surface-2 text-muted border px-3 py-2" style="font-size: 12px; border-radius: 6px;">
                @(Model.Lines?.Count ?? 0) Lines
            </span>
        </div>
        <div class="table-body-scroll">
            <table class="premium-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Product</th>
                        <th>Recipe</th>
                        <th class="text-end">Qty</th>
                        <th>Date</th>
                        <th>Priority</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in Model.Lines)
                    {
                        <tr>
                            <td>@line.LineNo</td>
                            <td><strong>@line.ProductName</strong></td>
                            <td>@line.RecipeCode</td>
                            <td class="text-end fw-bold">@line.PlannedQty.ToString("N4") <small class="text-muted">@line.UOMName</small></td>
                            <td>@line.PlannedDate.ToString("dd MMM yyyy")</td>
                            <td>@line.Priority</td>
                            <td><partial name="_StatusPill" model="line.Status" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- History Bar (Fills Space) -->
    <div class="history-bar">
        <i class="bi bi-clock-history text-muted" style="font-size: 20px;"></i>
        <div class="history-item">
            <span class="history-label">Created At</span>
            <span class="history-value">@Model.CreatedAt.ToString("dd MMM yyyy, HH:mm")</span>
        </div>
        @if (Model.ApprovedAt.HasValue)
        {
            <div class="history-item">
                <span class="history-label">Approved At</span>
                <span class="history-value">@Model.ApprovedAt.Value.ToString("dd MMM yyyy, HH:mm")</span>
            </div>
        }
    </div>
</div>