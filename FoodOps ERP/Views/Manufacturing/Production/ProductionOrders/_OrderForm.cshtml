@model FoodOpsERP.Models.Manufacturing.Production.ViewModels.ProductionOrderViewModel
@{
    var isEdit = Model.ProductionOrderID != 0;
    var plants = ViewData["Plants"] as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new();
    var products = ViewData["Products"] as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new();
    var recipes = ViewData["Recipes"] as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new();
    var uoms = ViewData["UOMs"] as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new();
}

<form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@(isEdit ? Model.ProductionOrderID.ToString() : null)"
      method="post" data-spa-form data-reload-url="@Url.Action("Index")" data-refresh="#grid-card" novalidate>
    
    <div class="fo-modal__body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        @if (isEdit)
        {
            <input type="hidden" asp-for="ProductionOrderID" />
        }

        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <label asp-for="PlantID" class="form-label">Plant <span class="text-danger">*</span></label>
                <select asp-for="PlantID" asp-items="plants" class="form-select" required><option value="">Select Plant...</option></select>
            </div>
            <div class="col-md-6">
                <label asp-for="ProductID" class="form-label">Product <span class="text-danger">*</span></label>
                <select asp-for="ProductID" asp-items="products" class="form-select" required><option value="">Select Product...</option></select>
            </div>
            <div class="col-md-6">
                <label asp-for="RecipeID" class="form-label">Recipe <span class="text-danger">*</span></label>
                <select asp-for="RecipeID" asp-items="recipes" class="form-select" required><option value="">Select Recipe...</option></select>
            </div>
            <div class="col-md-3">
                <label asp-for="TargetQty" class="form-label">Target Qty <span class="text-danger">*</span></label>
                <input asp-for="TargetQty" type="number" step="0.0001" class="form-control num" />
            </div>
            <div class="col-md-3">
                <label asp-for="UOMID" class="form-label">UOM <span class="text-danger">*</span></label>
                <select asp-for="UOMID" asp-items="uoms" class="form-select" required><option value="">UOM</option></select>
            </div>
            <div class="col-md-3">
                <label asp-for="Priority" class="form-label">Priority</label>
                <select asp-for="Priority" class="form-select">
                    <option value="1">1 - Critical</option>
                    <option value="2">2 - High</option>
                    <option value="3">3 - Medium</option>
                    <option value="4">4 - Low</option>
                    <option value="5">5 - Very Low</option>
                </select>
            </div>
            <div class="col-md-3">
                <label asp-for="PlannedStart" class="form-label">Planned Start</label>
                <input asp-for="PlannedStart" type="datetime-local" class="form-control" />
            </div>
            <div class="col-md-3">
                <label asp-for="PlannedEnd" class="form-label">Planned End</label>
                <input asp-for="PlannedEnd" type="datetime-local" class="form-control" />
            </div>
            <div class="col-12">
                <label asp-for="Remarks" class="form-label">Remarks</label>
                <textarea asp-for="Remarks" class="form-control" rows="2"></textarea>
            </div>
        </div>
    </div>

    <div class="fo-modal__footer">
        <button type="button" class="btn btn-outline-secondary" data-modal-close>Cancel</button>
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i><span>@(isEdit ? "Update Order" : "Create Order")</span></button>
    </div>
</form>