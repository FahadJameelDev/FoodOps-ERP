@{
    ViewData["Title"] = "Record Wastage";
    ViewData["Subtitle"] = $"Order: {ViewBag.OrderNumber}";
    var orderId = (int)ViewBag.OrderId;
}
<partial name="_PageHeader" />

<div class="card">
    <div class="card-body">
        <form asp-action="RecordWastage" asp-route-id="@orderId" method="post" data-spa-form data-reload-url="@Url.Action("Details", new { id = orderId })">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Wastage Type</label>
                    <select name="wastageType" class="form-select">
                        <option value="ProcessLoss">Process Loss</option>
                        <option value="Spillage">Spillage</option>
                        <option value="Rework">Rework</option>
                        <option value="Reject">Reject</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Quantity</label>
                    <input name="qty" type="number" step="0.0001" class="form-control" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Reason</label>
                    <input name="reason" class="form-control" required />
                </div>
                <div class="col-12 mt-4">
                    <button type="submit" class="btn btn-danger">Record Wastage</button>
                    <a href="@Url.Action("Details", new { id = orderId })" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </div>
        </form>
    </div>
</div>