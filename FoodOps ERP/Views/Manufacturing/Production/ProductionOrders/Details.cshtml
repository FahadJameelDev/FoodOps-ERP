@model FoodOpsERP.Models.Manufacturing.Production.ViewModels.ProductionOrderViewModel
@{
    ViewData["Title"] = $"Order {Model.OrderNumber}";
    ViewData["Subtitle"] = $"Status: {Model.Status}";
}

<partial name="_PageHeader" />

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card mb-3">
            <div class="card-header">
                <h5 class="card-title"><i class="bi bi-info-circle"></i>Order Info <partial name="_StatusPill" model="Model.Status" /></h5>
                <div class="grid-tools">
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i>Back</a>
                    
                    @if (Model.Status == "Planned")
                    {
                        <button type="button" class="btn btn-primary btn-sm" data-action-url="@Url.Action("Release", new { id = Model.ProductionOrderID })" data-confirm-title="Release Order?" data-confirm-text="Release" data-reload-url="@Url.Action("Details", new { id = Model.ProductionOrderID })"><i class="bi bi-box-arrow-up"></i>Release</button>
                    }
                    @if (Model.Status == "Released" || Model.Status == "OnHold")
                    {
                        <button type="button" class="btn btn-success btn-sm" data-action-url="@Url.Action("Start", new { id = Model.ProductionOrderID })" data-confirm-title="Start Order?" data-confirm-text="Start" data-reload-url="@Url.Action("Details", new { id = Model.ProductionOrderID })"><i class="bi bi-play-fill"></i>Start</button>
                    }
                    @if (Model.Status == "InProgress")
                    {
                        <button type="button" class="btn btn-warning btn-sm text-dark" data-action-url="@Url.Action("Hold", new { id = Model.ProductionOrderID })" data-confirm-title="Hold Order?" data-confirm-text="Hold" data-reload-url="@Url.Action("Details", new { id = Model.ProductionOrderID })"><i class="bi bi-pause-fill"></i>Hold</button>
                        <button type="button" class="btn btn-success btn-sm" data-action-url="@Url.Action("Complete", new { id = Model.ProductionOrderID })" data-confirm-title="Complete Order?" data-confirm-text="Complete" data-reload-url="@Url.Action("Details", new { id = Model.ProductionOrderID })"><i class="bi bi-check-circle"></i>Complete</button>
                    }
                    @if (Model.Status == "Completed")
                    {
                        <button type="button" class="btn btn-secondary btn-sm" data-action-url="@Url.Action("Close", new { id = Model.ProductionOrderID })" data-confirm-title="Close Order?" data-confirm-text="Close" data-reload-url="@Url.Action("Details", new { id = Model.ProductionOrderID })"><i class="bi bi-lock"></i>Close</button>
                    }
                    @if (Model.Status != "Closed" && Model.Status != "Cancelled")
                    {
                        <button type="button" class="btn btn-outline-danger btn-sm" data-action-url="@Url.Action("Cancel", new { id = Model.ProductionOrderID })" data-confirm-title="Cancel Order?" data-confirm-text="Cancel" data-reload-url="@Url.Action("Details", new { id = Model.ProductionOrderID })"><i class="bi bi-x-circle"></i>Cancel</button>
                    }
                </div>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4"><span class="text-muted d-block fs-xs">Product</span><b>@Model.ProductName</b></div>
                    <div class="col-md-4"><span class="text-muted d-block fs-xs">Recipe</span><b>@Model.RecipeCode</b></div>
                    <div class="col-md-4"><span class="text-muted d-block fs-xs">Target Qty</span><b>@Model.TargetQty @Model.UOMName</b></div>
                    <div class="col-md-4"><span class="text-muted d-block fs-xs">Produced Qty</span><b>@Model.ProducedQty</b></div>
                    <div class="col-md-4"><span class="text-muted d-block fs-xs">Rejected Qty</span><b>@Model.RejectedQty</b></div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header"><h5 class="card-title"><i class="bi bi-gear-wide-connected"></i>Operations</h5></div>
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead><tr><th>#</th><th>Operation</th><th>Work Center</th><th class="num">Std Mins</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
                    <tbody>
                        @foreach (var op in Model.Operations)
                        {
                            <tr>
                                <td>@op.SequenceOrder</td>
                                <td><strong>@op.OperationName</strong></td>
                                <td>@op.WorkCenterName</td>
                                <td class="num">@op.StandardMinutes</td>
                                <td><partial name="_StatusPill" model="op.Status" /></td>
                                <td class="text-end">
                                    @if (op.Status == "Pending" || op.Status == "Paused")
                                    {
                                        <button type="button" class="btn btn-sm btn-success" data-action-url="@Url.Action("StartOperation", new { id = op.OperationID })" data-confirm-title="Start Operation?" data-confirm-text="Start" data-reload-url="@Url.Action("Details", new { id = Model.ProductionOrderID })">Start</button>
                                    }
                                    @if (op.Status == "Running")
                                    {
                                        <button type="button" class="btn btn-sm btn-primary" data-action-url="@Url.Action("CompleteOperation", new { id = op.OperationID })" data-confirm-title="Complete Operation?" data-confirm-text="Complete" data-reload-url="@Url.Action("Details", new { id = Model.ProductionOrderID })">Complete</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-header"><h5 class="card-title"><i class="bi bi-lightning-charge"></i>Quick Actions</h5></div>
            <div class="card-body d-flex flex-column gap-2">
                <a href="@Url.Action("Execution", new { id = Model.ProductionOrderID })" class="btn btn-outline-primary btn-sm"><i class="bi bi-box-arrow-up"></i>Material Execution / Output</a>
                <a href="@Url.Action("Wastage", new { id = Model.ProductionOrderID })" class="btn btn-outline-secondary btn-sm"><i class="bi bi-trash3"></i>Record Wastage</a>
                <a href="@Url.Action("Exceptions", new { id = Model.ProductionOrderID })" class="btn btn-outline-danger btn-sm"><i class="bi bi-exclamation-triangle"></i>Report Exception</a>
            </div>
        </div>
    </div>
</div>