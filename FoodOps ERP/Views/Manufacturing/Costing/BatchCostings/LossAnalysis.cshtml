@model dynamic
@{
    ViewData["Title"] = "Loss Analysis";
    ViewData["Subtitle"] = "Wastage and downtime impact";
}

<partial name="_PageHeader" />

<div class="row g-3 mb-4">
    <!-- KPI 1: Total Wastage -->
    <div class="col-md-6">
        <div class="card kpi-card">
            <div class="kpi-header">
                <div class="kpi-title">Total Wastage Quantity</div>
                <div class="kpi-icon kpi-red"><i class="bi bi-trash3"></i></div>
            </div>
            <div class="kpi-value">
                @(Model.TotalWastageQty != null ? Convert.ToDecimal(Model.TotalWastageQty).ToString("N2") : "0")
            </div>
            <div class="kpi-meta">Units lost due to wastage</div>
        </div>
    </div>

    <!-- KPI 2: Total Downtime -->
    <div class="col-md-6">
        <div class="card kpi-card">
            <div class="kpi-header">
                <div class="kpi-title">Total Downtime</div>
                <div class="kpi-icon kpi-amber"><i class="bi bi-clock-history"></i></div>
            </div>
            <div class="kpi-value">
                @(Model.TotalDowntimeHours != null ? Convert.ToDecimal(Model.TotalDowntimeHours).ToString("N1") : "0") <span class="fs-sm">hrs</span>
            </div>
            <div class="kpi-meta">Machine hours lost</div>
        </div>
    </div>
</div>

<div class="card" id="grid-card">
    <div class="card-header">
        <h5 class="card-title"><i class="bi bi-list-ul"></i>Recent Wastage Records</h5>
    </div>
    
    <div class="table-scroll">
        @if (Model.WastageDetails != null && Model.WastageDetails.Count > 0)
        {
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Type</th>
                        <th class="num">Quantity</th>
                        <th>Reason</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.WastageDetails)
                    {
                        <tr>
                            <td>@item.Date</td>
                            <td><partial name="_StatusPill" model="item.Type" /></td>
                            <td class="num text-danger">@Convert.ToDecimal(item.Quantity).ToString("N2")</td>
                            <td class="text-muted">@item.Reason</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <partial name="_EmptyState" model='"No wastage records found. Your factory is running perfectly!"' />
        }
    </div>
</div>