@model FoodOpsERP.Models.Manufacturing.Costing.ViewModels.CostComponentViewModel
@{
    var isEdit = Model.ComponentID != 0;
    var types = ViewData["ComponentTypes"] as SelectList ?? new SelectList(Enumerable.Empty<string>());
    var bases = ViewData["AllocationBases"] as SelectList ?? new SelectList(Enumerable.Empty<string>());
}

<form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@(isEdit ? Model.ComponentID.ToString() : null)" method="post" data-spa-form data-reload-url="@Url.Action("Index")" data-refresh="#grid-card" novalidate>
    <div class="fo-modal__body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        @if (isEdit)
        {
            <input type="hidden" asp-for="ComponentID" />
        }
        <div class="row g-3">
            <div class="col-md-6"><label asp-for="ComponentCode" class="form-label">Code <span class="text-danger">*</span></label><input asp-for="ComponentCode" class="form-control" readonly="@isEdit" /><span asp-validation-for="ComponentCode" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="ComponentName" class="form-label">Name <span class="text-danger">*</span></label><input asp-for="ComponentName" class="form-control" /><span asp-validation-for="ComponentName" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="ComponentType" class="form-label">Type <span class="text-danger">*</span></label><select asp-for="ComponentType" asp-items="types" class="form-select"></select></div>
            <div class="col-md-6"><label asp-for="AllocationBasis" class="form-label">Allocation Basis <span class="text-danger">*</span></label><select asp-for="AllocationBasis" asp-items="bases" class="form-select"></select></div>
            <div class="col-12 mt-3"><div class="form-check"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">Is Active</label></div></div>
        </div>
    </div>
    <div class="fo-modal__footer">
        <button type="button" class="btn btn-outline-secondary" data-modal-close>Cancel</button>
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i><span>@(isEdit ? "Update" : "Save")</span></button>
    </div>
</form>