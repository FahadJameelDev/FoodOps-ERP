@model FoodOpsERP.Models.Manufacturing.Costing.ViewModels.OverheadAllocationViewModel
@{
    var plants = ViewData["Plants"] as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new();
    var components = ViewData["Components"] as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new();
}

<form asp-action="CreateOverhead" method="post" data-spa-form data-reload-url="@Url.Action("OverheadAllocations")" data-refresh="#grid-card" novalidate>
    <div class="fo-modal__body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="PlantID" class="form-label">Plant <span class="text-danger">*</span></label>
                <select asp-for="PlantID" asp-items="plants" class="form-select"><option value="">Select Plant...</option></select>
                <span asp-validation-for="PlantID" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="ComponentID" class="form-label">Cost Component <span class="text-danger">*</span></label>
                <select asp-for="ComponentID" asp-items="components" class="form-select"><option value="">Select Component...</option></select>
                <span asp-validation-for="ComponentID" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="PeriodMonth" class="form-label">Month <span class="text-danger">*</span></label>
                <input asp-for="PeriodMonth" type="month" class="form-control" />
                <span asp-validation-for="PeriodMonth" class="text-danger"></span>
            </div>
            
            <div class="col-md-6">
                <label asp-for="AllocatedAmount" class="form-label">Allocated Amount <span class="text-danger">*</span></label>
                <input asp-for="AllocatedAmount" type="number" step="0.01" class="form-control num" />
                <span asp-validation-for="AllocatedAmount" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="BasisQty" class="form-label">Basis Qty (e.g., Machine Hours) <span class="text-danger">*</span></label>
                <input asp-for="BasisQty" type="number" step="0.0001" class="form-control num" />
                <span asp-validation-for="BasisQty" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="fo-modal__footer">
        <button type="button" class="btn btn-outline-secondary" data-modal-close>Cancel</button>
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i><span>Save Allocation</span></button>
    </div>
</form>