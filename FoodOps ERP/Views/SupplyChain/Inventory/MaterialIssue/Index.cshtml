@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Material Issue & Return"; ViewData["Subtitle"] = "Issue stock to production or return unused material"; ViewData["Icon"] = "bi-box-arrow-up"; ViewData["Mode"] = "issue";
}
<partial name="_PageHeader" />

<div class="card" id="grid-card">
    <div class="card-header">
        <h5 class="card-title"><i class="bi bi-boxes"></i>Available lots<span class="count-chip">@Model.Count()</span></h5>
        <div class="grid-tools">
            <label class="grid-search"><i class="bi bi-search"></i><input type="search" placeholder="Search lots…" aria-label="Search lots" data-table-filter="#issue-grid" /></label>
            <a asp-action="Create" class="btn btn-primary btn-sm" data-modal="true" data-modal-title="Issue material" data-modal-size="md" data-modal-icon="bi-box-arrow-up"><i class="bi bi-box-arrow-up"></i>Issue</a>
            <a asp-action="Return" class="btn btn-outline-secondary btn-sm" data-modal="true" data-modal-title="Return material" data-modal-size="md" data-modal-icon="bi-box-arrow-in-down"><i class="bi bi-box-arrow-in-down"></i>Return</a>
        </div>
    </div>
    <div class="table-responsive table-scroll" id="issue-grid"><partial name="_LotsTable" model="Model" /></div>
</div>