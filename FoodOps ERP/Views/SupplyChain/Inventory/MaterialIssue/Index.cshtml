@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Material Issue & Return";
    ViewData["Subtitle"] = "Issue stock to production or return unused material";
    ViewData["Mode"] = "issue";
}
<partial name="_PageHeader" />

<div class="card" id="grid-card">
    @Html.GridToolbar("Search lots…", "lots", Model.Count(), null, @<text>
        <a href="@Url.Action("Return")" class="btn btn-outline-secondary btn-sm"
               data-modal="true" data-modal-title="Return material" data-modal-size="md" data-modal-icon="bi-box-arrow-in-down">
            <i class="bi bi-box-arrow-in-down"></i>Return
        </a>
        <a href="@Url.Action("Create")" class="btn btn-primary btn-sm"
               data-modal="true" data-modal-title="Issue material" data-modal-size="md" data-modal-icon="bi-box-arrow-up">
            <i class="bi bi-box-arrow-up"></i>Issue material
        </a>
    </text>)
<div class="table-scroll">
        <partial name="_LotsTable" model="Model" />
    </div>
</div>