@model StockMovementViewModel
@{
    var batches = ViewData["Batches"] as List<SelectListItem> ?? new List<SelectListItem>();
    var isReturn = Model.Kind == "Return";
}
<form asp-action="@(isReturn ? "Return" : "Create")" method="post" data-spa-form data-reload-url="@Url.Action("Index")" data-refresh="#grid-card" novalidate>
    <div class="fo-modal__body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <input type="hidden" asp-for="Kind" />
        <div class="row g-3">
            <div class="col-12">
                <label asp-for="BatchId" class="form-label">Batch <span class="text-danger">*</span></label>
                <select asp-for="BatchId" asp-items="batches" class="form-select"><option value="">Select batch…</option></select><span asp-validation-for="BatchId"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Qty" class="form-label">Quantity to @(isReturn ? "return" : "issue") <span class="text-danger">*</span></label>
                <input asp-for="Qty" type="number" step="0.0001" min="0.0001" class="form-control num" placeholder="e.g., 25" />
                <div class="form-hint">@(isReturn ? "Stock will increase by this quantity." : "Stock will decrease by this quantity.")</div><span asp-validation-for="Qty"></span>
            </div>
            <div class="col-12">
                <label asp-for="Remarks" class="form-label">Remarks</label>
                <textarea asp-for="Remarks" class="form-control" rows="2" placeholder="@(isReturn ? "Reason for return…" : "Production order, line, shift…")"></textarea><span asp-validation-for="Remarks"></span>
            </div>
        </div>
    </div>
    <div class="fo-modal__footer">
        <button type="button" class="btn btn-outline-secondary" data-modal-close>Cancel</button>
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i><span>@(isReturn ? "Return material" : "Issue material")</span></button>
    </div>
</form>