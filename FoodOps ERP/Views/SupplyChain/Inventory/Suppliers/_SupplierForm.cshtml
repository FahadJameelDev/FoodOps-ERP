@model SupplierViewModel
@{
    var isEdit = Model.SupplierID != 0;
}

<form asp-action="@(isEdit ? "Edit" : "Create")"
      asp-route-id="@(isEdit ? Model.SupplierID.ToString() : null)"
      method="post"
      data-spa-form
      data-reload-url="@Url.Action("Index")"
      data-refresh="#supplier-grid"
      novalidate>

    <div class="fo-modal__body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        @if (isEdit)
        {
            <input type="hidden" asp-for="SupplierID" />
        }

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="SupplierCode" class="form-label">Supplier Code <span class="text-danger">*</span></label>
                <input asp-for="SupplierCode" class="form-control" placeholder="e.g., SUP001" />
                <span asp-validation-for="SupplierCode"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="SupplierName" class="form-label">Supplier Name <span class="text-danger">*</span></label>
                <input asp-for="SupplierName" class="form-control" placeholder="e.g., ABC Traders" />
                <span asp-validation-for="SupplierName"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="ContactPerson" class="form-label">Contact Person</label>
                <input asp-for="ContactPerson" class="form-control" placeholder="e.g., Ahmed Khan" />
                <span asp-validation-for="ContactPerson"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" type="email" class="form-control" placeholder="e.g., contact@abc.com" />
                <span asp-validation-for="Email"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Phone" class="form-label">Phone</label>
                <input asp-for="Phone" type="tel" class="form-control" placeholder="e.g., +92 300 1234567" />
                <span asp-validation-for="Phone"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Rating" class="form-label">Rating (0 - 5)</label>
                <input asp-for="Rating" type="number" step="0.1" min="0" max="5" class="form-control" placeholder="e.g., 4.5" />
                <span asp-validation-for="Rating"></span>
            </div>
            <div class="col-12">
                <label asp-for="Address" class="form-label">Address</label>
                <textarea asp-for="Address" class="form-control" rows="3" placeholder="Full address..."></textarea>
                <span asp-validation-for="Address"></span>
            </div>
            <div class="col-12">
                <div class="form-check form-switch">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
                    <label asp-for="IsActive" class="form-check-label">Active Supplier</label>
                </div>
            </div>
        </div>
    </div>

    <div class="fo-modal__footer">
        <button type="button" class="btn btn-outline-secondary" data-modal-close>Cancel</button>
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-lg"></i><span>@(isEdit ? "Update Supplier" : "Save Supplier")</span>
        </button>
    </div>
</form>