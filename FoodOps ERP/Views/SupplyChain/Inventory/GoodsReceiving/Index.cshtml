@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Goods Receiving (GRN)";
    ViewData["Subtitle"] = "Receive goods against approved purchase orders";
}
<partial name="_PageHeader" />

<div class="card" id="grid-card">
    @Html.GridToolbar("Search orders…", "awaiting receipt", Model.Count())
    <div class="table-scroll">
        @if (!Model.Any())
        {
            ViewData["EmptyIcon"] = "bi-check2-all";
            <partial name="_EmptyState" model='"Nothing waiting to be received. Approved purchase orders will appear here."' />
        }
        else
        {
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>PO #</th>
                        <th>Supplier</th>
                        <th>Order date</th>
                        <th>Expected</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var po in Model)
                    {
                        <tr>
                            <td><span class="code">@po.POCode</span></td>
                            <td>@po.SupplierName</td>
                            <td>@Fmt.Date(po.OrderDate)</td>
                            <td>@Fmt.Date(po.ExpectedDate)</td>
                            <td><partial name="_StatusPill" model="po.Status" /></td>
                            <td class="text-end">
                                <a asp-action="Create" asp-route-id="@po.POID" class="btn btn-primary btn-sm"
                                       data-modal="true"
                                       data-modal-title="Receive goods — @po.POCode"
                                       data-modal-size="xl"
                                       data-modal-icon="bi-box-arrow-in-down">
                                    <i class="bi bi-box-arrow-in-down"></i>Receive
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>