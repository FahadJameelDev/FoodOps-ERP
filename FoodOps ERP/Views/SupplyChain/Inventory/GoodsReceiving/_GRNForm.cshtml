@model GRNViewModel
@{
    var bins = ViewData["Bins"] as List<SelectListItem> ?? new List<SelectListItem>();
}
<form asp-action="Create" method="post" data-spa-form data-reload-url="@Url.Action("Index")" data-refresh="#grid-card" novalidate>
    <div class="fo-modal__body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <input type="hidden" asp-for="POID" />
        <input type="hidden" asp-for="POCode" />
        <input type="hidden" asp-for="SupplierName" />
        <input type="hidden" asp-for="SupplierID" /> <!-- SupplierID zaroori hai -->

        <div class="info-strip">
            <div><span>Purchase order</span><b>@Model.POCode</b></div>
            <div><span>Supplier</span><b>@Model.SupplierName</b></div>
        </div>
        <div class="row g-3 mb-3">
            <div class="col-md-4">
                <label asp-for="ReceivedDate" class="form-label">Received date <span class="text-danger">*</span></label>
                <input asp-for="ReceivedDate" type="date" class="form-control" /><span asp-validation-for="ReceivedDate"></span>
            </div>
            <div class="col-md-8">
                <label asp-for="Remarks" class="form-label">Remarks</label>
                <input asp-for="Remarks" class="form-control" placeholder="Delivery note, vehicle, condition…" /><span asp-validation-for="Remarks"></span>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th class="num">Ordered</th>
                        <th class="num">Received</th>
                        <th style="width:120px">Receive now</th>
                        <th style="width:150px">Batch #</th>
                        <th style="width:140px">Mfg date</th>
                        <th style="width:140px">Expiry</th>
                        <th style="width:170px">Bin</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < Model.Items.Count; i++)
                    {
                        <tr>
                            <td>
                                <input type="hidden" asp-for="Items[i].POItemID" />
                                <input type="hidden" asp-for="Items[i].ProductID" />
                                <input type="hidden" asp-for="Items[i].ProductName" />
                                <input type="hidden" asp-for="Items[i].UOMCode" />
                                <input type="hidden" asp-for="Items[i].OrderedQty" />
                                <input type="hidden" asp-for="Items[i].ReceivedQty" />
                                <strong>@Model.Items[i].ProductName</strong>
                            </td>
                            <td class="num">@Fmt.Qty(Model.Items[i].OrderedQty)</td>
                            <td class="num">@Fmt.Qty(Model.Items[i].ReceivedQty)</td>
                            
                            <!-- ✅ FIX: Name changed to ReceivingQty -->
                            <td><input asp-for="Items[i].ReceivingQty" type="number" step="0.0001" min="0" max="@Math.Max(Model.Items[i].OrderedQty - Model.Items[i].ReceivedQty, 0)" class="form-control num" /><span asp-validation-for="Items[i].ReceivingQty"></span></td>
                            
                            <td><input asp-for="Items[i].BatchNumber" class="form-control" placeholder="Batch no." /><span asp-validation-for="Items[i].BatchNumber"></span></td>
                            <td><input asp-for="Items[i].ManufacturingDate" type="date" class="form-control" /></td>
                            <td><input asp-for="Items[i].ExpiryDate" type="date" class="form-control" /><span asp-validation-for="Items[i].ExpiryDate"></span></td>
                            <td><select asp-for="Items[i].BinID" asp-items="bins" class="form-select"><option value="">Select bin…</option></select></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="fo-modal__footer">
        <button type="button" class="btn btn-outline-secondary" data-modal-close>Cancel</button>
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i><span>Confirm receipt</span></button>
    </div>
</form>