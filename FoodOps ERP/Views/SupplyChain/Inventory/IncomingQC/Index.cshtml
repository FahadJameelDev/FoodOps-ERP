@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Incoming QC";
    ViewData["Subtitle"] = "Inspect received batches before they enter usable stock";
}
<partial name="_PageHeader" />

<div class="card" id="grid-card">
    @Html.GridToolbar("Search batches…", "pending", Model.Count())
    <div class="table-scroll">
        @if (!Model.Any())
        {
            ViewData["EmptyIcon"] = "bi-check2-all";
            <partial name="_EmptyState" model='"No batches awaiting QC. You are all caught up."' />
        }
        else
        {
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Batch #</th>
                        <th>Product</th>
                        <th class="num">Quantity</th>
                        <th>Received</th>
                        <th>QC status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model)
                    {
                        string qc = Convert.ToString(b.QCStatus) ?? "";
                        bool held = qc.Contains("hold", StringComparison.OrdinalIgnoreCase)
                                 || qc.Contains("quarantine", StringComparison.OrdinalIgnoreCase);
                        <tr>
                            <td><span class="code">@b.BatchNumber</span></td>
                            <td>@b.ProductName</td>
                            <td class="num">@Fmt.Qty(b.CurrentQuantity)</td>
                            <td>@Fmt.Date(b.ReceivedDate)</td>
                            <td><partial name="_StatusPill" model="b.QCStatus" /></td>
                            <td class="text-end">
                                <div class="row-actions">
                                    @if (held)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                                data-action-url="@Url.Action("Release", new { id = b.BatchID })"
                                                data-name="@b.BatchNumber"
                                                data-confirm-title="Release batch?"
                                                data-confirm-message="The batch will leave hold and become available."
                                                data-confirm-text="Release"
                                                data-refresh="#grid-card">
                                            <i class="bi bi-unlock"></i>Release
                                        </button>
                                    }
                                    else
                                    {
                                        <a asp-action="Inspect" asp-route-id="@b.BatchID" class="btn btn-primary btn-sm"
                                               data-modal="true"
                                               data-modal-title="Inspect batch @b.BatchNumber"
                                               data-modal-size="md"
                                               data-modal-icon="bi-patch-check">
                                            <i class="bi bi-search"></i>Inspect
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>