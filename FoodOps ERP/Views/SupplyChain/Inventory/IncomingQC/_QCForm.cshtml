@model QCDecisionViewModel

<form asp-action="Inspect" method="post" data-spa-form data-reload-url="@Url.Action("Index")" data-refresh="#grid-card" novalidate>
    <div class="fo-modal__body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="BatchNumber" />
        <input type="hidden" asp-for="ProductName" />
        <input type="hidden" asp-for="Quantity" />

        <!-- ✅ Premium Info Grid -->
        <div class="qc-info-grid mb-4">
            <div class="qc-info-box">
                <span class="qc-label">Batch</span>
                <span class="qc-value">@Model.BatchNumber</span>
            </div>
            <div class="qc-info-box">
                <span class="qc-label">Product</span>
                <span class="qc-value">@Model.ProductName</span>
            </div>
            <div class="qc-info-box">
                <span class="qc-label">Quantity</span>
                <span class="qc-value">@Fmt.Qty(Model.Quantity)</span>
            </div>
        </div>

        <!-- ✅ Premium Decision Radio Group -->
        <div class="mb-4">
            <label class="form-label mb-2">Decision <span class="text-danger">*</span></label>
            <div class="qc-choice-group">
                <label class="qc-choice qc-choice--pass">
                    <input type="radio" asp-for="Decision" value="Pass" />
                    <span class="qc-choice-content">
                        <i class="bi bi-check-circle"></i>
                        <span>Pass</span>
                    </span>
                </label>
                <label class="qc-choice qc-choice--fail">
                    <input type="radio" asp-for="Decision" value="Fail" />
                    <span class="qc-choice-content">
                        <i class="bi bi-x-circle"></i>
                        <span>Fail</span>
                    </span>
                </label>
                <label class="qc-choice qc-choice--hold">
                    <input type="radio" asp-for="Decision" value="Hold" />
                    <span class="qc-choice-content">
                        <i class="bi bi-pause-circle"></i>
                        <span>Hold</span>
                    </span>
                </label>
            </div>
            <span asp-validation-for="Decision" class="text-danger small"></span>
        </div>

        <!-- ✅ Premium Textarea -->
        <div>
            <label asp-for="Remarks" class="form-label">Remarks</label>
            <textarea asp-for="Remarks" class="form-control" rows="3" placeholder="Findings, test readings, reason..."></textarea>
            <div class="form-hint mt-1"><i class="bi bi-info-circle me-1"></i> Required when failing or holding a batch.</div>
            <span asp-validation-for="Remarks" class="text-danger small"></span>
        </div>
    </div>
    
    <!-- ✅ Premium Footer -->
    <div class="fo-modal__footer" style="background: #F8FAFC; border-top: 1px solid var(--border); padding: 16px 24px;">
        <button type="button" class="btn btn-outline-secondary px-4" data-modal-close>Cancel</button>
        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check-lg me-1"></i> Submit Decision</button>
    </div>
</form>

<style>
    /* ✅ MICROSOFT FLUENT - PREMIUM QC FORM STYLING */
    
    /* Info Grid */
    .qc-info-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
    }
    .qc-info-box {
        background: var(--surface-2); border: 1px solid var(--border); border-radius: 8px;
        padding: 12px 16px; display: flex; flex-direction: column; gap: 4px;
    }
    .qc-label { font-size: 11px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.03em; }
    .qc-value { font-size: 15px; font-weight: 700; color: var(--text-heading); }

    /* Form Elements */
    .form-label { font-size: 12px; font-weight: 600; color: var(--text-heading); margin-bottom: 6px; }
    .form-control {
        border-radius: 8px; border: 1px solid var(--line-strong); font-size: 13px; padding: 10px 14px;
        transition: all 0.2s; background: var(--surface-2);
    }
    .form-control:focus {
        outline: none; background: #fff; border-color: var(--emerald); box-shadow: 0 0 0 3px var(--emerald-glow);
    }

    /* ✅ Premium Choice Group (Replaces radio buttons) */
    .qc-choice-group {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
    }
    .qc-choice { position: relative; cursor: pointer; margin: 0; }
    .qc-choice input { position: absolute; opacity: 0; width: 0; height: 0; }
    
    .qc-choice-content {
        display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px;
        padding: 16px; border: 2px solid var(--border); border-radius: 10px;
        background: #fff; transition: all 0.2s; text-align: center;
    }
    .qc-choice-content i { font-size: 24px; }
    .qc-choice-content span { font-size: 13px; font-weight: 600; color: var(--text-body); }
    
    /* Pass Hover */
    .qc-choice--pass:hover .qc-choice-content { border-color: #10B981; background: #F0FDF4; }
    .qc-choice--pass input:checked + .qc-choice-content { border-color: #10B981; background: #ECFDF5; }
    .qc-choice--pass input:checked + .qc-choice-content i { color: #059669; }
    .qc-choice--pass input:checked + .qc-choice-content span { color: #059669; }

    /* Fail Hover */
    .qc-choice--fail:hover .qc-choice-content { border-color: #EF4444; background: #FEF2F2; }
    .qc-choice--fail input:checked + .qc-choice-content { border-color: #EF4444; background: #FEF2F2; }
    .qc-choice--fail input:checked + .qc-choice-content i { color: #DC2626; }
    .qc-choice--fail input:checked + .qc-choice-content span { color: #DC2626; }

    /* Hold Hover */
    .qc-choice--hold:hover .qc-choice-content { border-color: #F59E0B; background: #FFFBEB; }
    .qc-choice--hold input:checked + .qc-choice-content { border-color: #F59E0B; background: #FFFBEB; }
    .qc-choice--hold input:checked + .qc-choice-content i { color: #D97706; }
    .qc-choice--hold input:checked + .qc-choice-content span { color: #D97706; }

    .form-hint { font-size: 11px; color: var(--text-muted); }
</style>