@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Stock Management";
    ViewData["Subtitle"] = "Current stock position by product";
}
<partial name="_PageHeader" />

<div class="card" id="grid-card">
    @Html.GridToolbar("Search products…", "products", Model.Count(), "All|Low|Out", @<text>
        <a href="@Url.Action("Movements")" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left-right"></i>Movements
        </a>
        <a href="@Url.Action("Adjust")" class="btn btn-primary btn-sm"
               data-modal="true" data-modal-title="Adjust Stock" data-modal-size="md" data-modal-icon="bi-sliders">
            <i class="bi bi-sliders"></i>Adjust stock
        </a>
    </text>)
<div class="table-scroll">
        @if (!Model.Any())
        {
            <partial name="_EmptyState" model='"No stock records yet."' />
        }
        else
        {
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Product</th>
                        <th class="num">On hand</th>
                        <th>UOM</th>
                        <th class="num">Min level</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td><span class="code">@s.ProductCode</span></td>
                            <td>@s.ProductName</td>
                            <td class="num">@Fmt.Qty(s.TotalQuantity)</td>
                            <td>@s.UOMCode</td>
                            <td class="num">@Fmt.Qty(s.MinStockLevel)</td>
                            <td><partial name="_StatusPill" model="s.StockStatus" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>