@model List<StockMovementRow>
@{
    ViewData["Title"] = "Stock Movements";
    ViewData["Subtitle"] = "Latest 200 inventory transactions";
}
<partial name="_PageHeader" />

<div class="card" id="grid-card">
    @Html.GridToolbar("Search movements…", "transactions", Model.Count, null, @<text>
        <a href="@Url.Action("Balance")" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-box-seam"></i>Stock balance
        </a>
    </text>)
<div class="table-scroll">
        @if (Model.Count == 0)
        {
            <partial name="_EmptyState" model='"No stock movements recorded yet."' />
        }
        else
        {
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>When</th>
                        <th>Batch #</th>
                        <th>Product</th>
                        <th>Type</th>
                        <th class="num">Quantity</th>
                        <th>Remarks</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model)
                    {
                        <tr>
                            <td>@m.Timestamp.ToString("dd MMM yyyy, HH:mm")</td>
                            <td><span class="code">@m.BatchNumber</span></td>
                            <td>@m.ProductName</td>
                            <td><partial name="_StatusPill" model="m.TransactionType" /></td>
                            <td class="num @(m.Quantity < 0 ? "text-danger" : "text-success")">
                                @(m.Quantity > 0 ? "+" : "")@Fmt.Qty(m.Quantity)
                            </td>
                            <td>@if (string.IsNullOrWhiteSpace(m.Remarks)) {
                                <span class="na">—</span>
                            } else
                            {

                                @m.Remarks
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
</div>