@model PurchaseOrderViewModel
@{
    ViewData["Title"] = $"PO {Model.POCode}";
    ViewData["Subtitle"] = "Purchase order details";
    bool isDraft = string.Equals(Model.Status, "Draft", StringComparison.OrdinalIgnoreCase);
}

<style>
    /* ✅ MICROSOFT FLUENT - PREMIUM PURCHASE ORDER DETAILS */
    .page-content { padding: 12px var(--content-x) 12px var(--content-x) !important; }

    .po-dashboard {
        display: flex;
        flex-direction: column;
        gap: 12px;
        height: calc(100vh - 140px);
    }

    /* Premium Header */
    .po-header-card {
        display: flex; align-items: center; justify-content: space-between;
        background: #ffffff; border: 1px solid var(--border);
        border-radius: var(--radius-card); padding: 12px 16px; flex-shrink: 0;
    }
    .header-icon { display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; background: #EFF6FF; color: #2563EB; border-radius: 8px; font-size: 18px; }
    .header-title { font-size: 18px; font-weight: 700; color: var(--text-heading); margin: 0; line-height: 1.2; }
    .header-subtitle { font-size: 11px; color: var(--text-muted); margin: 0; }

    /* Summary Stats Grid */
    .summary-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 12px;
        flex-shrink: 0;
    }
    .summary-box {
        background: #fff; border: 1px solid var(--border); border-radius: var(--radius-card);
        padding: 16px; display: flex; flex-direction: column; gap: 4px;
    }
    .summary-label { font-size: 11px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.03em; }
    .summary-value { font-size: 15px; font-weight: 700; color: var(--text-heading); line-height: 1.2; }

    /* Remarks Card */
    .remarks-card {
        background: #FFFBEB; border: 1px solid #FDE68A; border-radius: var(--radius-card);
        padding: 12px 16px; font-size: 13px; color: #B45309; display: flex; align-items: flex-start; gap: 8px;
    }

    /* Items Table Card */
    .table-card {
        flex: 1;
        background: #fff; border: 1px solid var(--border); border-radius: var(--radius-card);
        display: flex; flex-direction: column; overflow: hidden; min-height: 0;
    }
    .table-card-header {
        padding: 12px 16px; border-bottom: 1px solid var(--divider); flex-shrink: 0;
        display: flex; align-items: center; justify-content: space-between;
    }
    .table-card-title { font-size: 15px; font-weight: 600; color: var(--text-heading); margin: 0; display: flex; align-items: center; gap: 8px; }

    .table-body-scroll { flex: 1; overflow-y: auto; min-height: 0; }
    .premium-table { width: 100%; border-collapse: separate; border-spacing: 0; margin: 0; }
    .premium-table th {
        background: var(--surface-2); color: var(--text-muted); font-size: 11px; font-weight: 600;
        text-transform: uppercase; letter-spacing: 0.05em; padding: 12px 16px;
        text-align: left; border-bottom: 1px solid var(--line); position: sticky; top: 0; z-index: 2;
    }
    .premium-table td {
        padding: 12px 16px; font-size: 13px; color: var(--text-body);
        border-bottom: 1px solid var(--divider); vertical-align: middle;
    }
    .premium-table tr:last-child td { border-bottom: none; }
    .premium-table tr:hover td { background: var(--surface-2); }
</style>

<div class="po-dashboard">
    <!-- 1. PREMIUM HEADER -->
    <div class="po-header-card">
        <div class="d-flex align-items-center gap-3">
            <div class="header-icon"><i class="bi bi-cart-check"></i></div>
            <div>
                <h1 class="header-title">Purchase Order @Model.POCode <partial name="_StatusPill" model="Model.Status" /></h1>
                <p class="header-subtitle">@Model.SupplierName</p>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm py-2 px-3" style="font-size: 12px;">
                <i class="bi bi-arrow-left me-1"></i> Back
            </a>
            @if (isDraft)
            {
                <a asp-action="Edit" asp-route-id="@Model.POID" class="btn btn-outline-secondary btn-sm py-2 px-3" style="font-size: 12px;"
                       data-modal="true" data-modal-title="Edit Purchase Order" data-modal-size="xl">
                    <i class="bi bi-pencil me-1"></i> Edit
                </a>
                <button type="button" class="btn btn-primary btn-sm py-2 px-3" style="font-size: 12px;"
                        data-action-url="@Url.Action("Approve", new { id = Model.POID })"
                        data-name="@Model.POCode"
                        data-confirm-title="Approve purchase order?"
                        data-confirm-text="Approve"
                        data-reload-url="@Url.Action("Details", new { id = Model.POID })">
                    <i class="bi bi-check2-circle me-1"></i> Approve
                </button>
            }
        </div>
    </div>

    <!-- 2. SUMMARY STATS GRID -->
    <div class="summary-grid">
        <div class="summary-box">
            <span class="summary-label">Supplier</span>
            <span class="summary-value">@Model.SupplierName</span>
        </div>
        <div class="summary-box">
            <span class="summary-label">Order Date</span>
            <span class="summary-value">@Fmt.Date(Model.OrderDate)</span>
        </div>
        <div class="summary-box">
            <span class="summary-label">Expected Date</span>
            <span class="summary-value">@Fmt.Date(Model.ExpectedDate)</span>
        </div>
        <div class="summary-box" style="background: #F0FDF4; border-color: #BBF7D0;">
            <span class="summary-label text-success">Total Amount</span>
            <span class="summary-value text-success">@Fmt.Money(Model.TotalAmount)</span>
        </div>
    </div>

    <!-- 3. REMARKS (Only if exists) -->
    @if (!string.IsNullOrWhiteSpace(Model.Remarks))
    {
        <div class="remarks-card">
            <i class="bi bi-info-circle-fill mt-1"></i>
            <div>@Model.Remarks</div>
        </div>
    }

    <!-- 4. ITEMS TABLE CARD -->
    <div class="table-card">
        <div class="table-card-header">
            <h5 class="table-card-title"><i class="bi bi-list-check"></i> Order Items</h5>
            <span class="badge bg-surface-2 text-muted border px-3 py-2" style="font-size: 12px; border-radius: 6px;">
                @(Model.Items?.Count ?? 0) Items
            </span>
        </div>
        <div class="table-body-scroll">
            <table class="premium-table">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>UOM</th>
                        <th class="text-end">Ordered</th>
                        <th class="text-end">Received</th>
                        <th class="text-end">Unit Cost</th>
                        <th class="text-end">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items is not null && Model.Items.Any())
                    {
                        foreach (dynamic it in Model.Items)
                        {
                            <tr>
                                <td><strong>@it.ProductName</strong></td>
                                <td>@it.UOMCode</td>
                                <td class="text-end">@Fmt.Qty(it.OrderedQty)</td>
                                <td class="text-end">@Fmt.Qty(it.ReceivedQty)</td>
                                <td class="text-end">@Fmt.Money(it.UnitCost)</td>
                                <td class="text-end fw-bold">@Fmt.Money((decimal)it.OrderedQty * (decimal)it.UnitCost)</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">No items found for this purchase order.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>