@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Purchase Orders";
    ViewData["Subtitle"] = "Create, approve and track purchase orders";
}
<partial name="_PageHeader" />

<div class="card" id="grid-card">
    @Html.GridToolbar("Search orders…", "orders", Model.Count(), "All|Draft|Approved", @<text>
        <a href="@Url.Action("Create")" class="btn btn-primary btn-sm"
               data-modal="true" data-modal-title="New Purchase Order" data-modal-size="xl" data-modal-icon="bi-cart-plus">
            <i class="bi bi-plus-lg"></i>New PO
        </a>
    </text>)
<div class="table-scroll">
        @if (!Model.Any())
        {
            <partial name="_EmptyState" model='"No purchase orders yet."' />
        }
        else
        {
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>PO #</th>
                        <th>Supplier</th>
                        <th>Order date</th>
                        <th>Expected</th>
                        <th class="num">Amount</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var po in Model)
                    {
                        string status = Convert.ToString(po.Status) ?? "";
                        bool isDraft = status.Equals("Draft", StringComparison.OrdinalIgnoreCase);
                        <tr>
                            <td><a asp-action="Details" asp-route-id="@po.POID" class="code">@po.POCode</a></td>
                            <td>@po.SupplierName</td>
                            <td>@Fmt.Date(po.OrderDate)</td>
                            <td>@Fmt.Date(po.ExpectedDate)</td>
                            <td class="num">@Fmt.Money(po.TotalAmount)</td>
                            <td><partial name="_StatusPill" model="po.Status" /></td>
                            <td class="text-end">
                                <div class="row-actions">
                                    <a asp-action="Details" asp-route-id="@po.POID" class="btn btn-sm btn-outline-secondary" title="View">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (isDraft)
                                    {
                                        <a asp-action="Edit" asp-route-id="@po.POID" class="btn btn-sm btn-outline-secondary" title="Edit"
                                               data-modal="true" data-modal-title="Edit Purchase Order" data-modal-size="xl" data-modal-icon="bi-pencil">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" title="Approve"
                                                data-action-url="@Url.Action("Approve", new { id = po.POID })"
                                                data-name="@po.POCode"
                                                data-confirm-title="Approve purchase order?"
                                                data-confirm-message="Once approved, goods can be received against this order."
                                                data-confirm-text="Approve"
                                                data-refresh="#grid-card">
                                            <i class="bi bi-check2-circle"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-danger" title="Delete"
                                                data-delete-url="@Url.Action("Delete", new { id = po.POID })"
                                                data-name="@po.POCode"
                                                data-refresh="#grid-card">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>