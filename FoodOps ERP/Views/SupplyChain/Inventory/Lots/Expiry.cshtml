@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Expiring Lots";
    ViewData["Subtitle"] = "Lots expiring in the selected window";
    ViewData["Mode"] = "expiry";
    int days = (int)ViewBag.Days;
}
<partial name="_PageHeader" />

<div class="card" id="grid-card">
    @Html.GridToolbar("Search lots…", "lots", Model.Count(), null, @<text>
        @foreach (var d in new[] { 7, 15, 30, 60, 90 })
        {
            <a href="@Url.Action("Expiry", new { days = d })"
                   class="btn btn-sm @(d == days ? "btn-primary" : "btn-outline-secondary")">
                @d days
            </a>
        }
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-list-ul"></i>All lots
        </a>
    </text>)
<div class="table-scroll">
        <partial name="_LotsTable" model="Model" />
    </div>
</div>