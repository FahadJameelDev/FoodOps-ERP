@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Lot & Expiry Tracking"; ViewData["Subtitle"] = "Track every lot, its quality status and expiry"; ViewData["Icon"] = "bi-upc-scan"; ViewData["Mode"] = "lots";
}
<partial name="_PageHeader" />

<div class="card" id="grid-card">
    <div class="card-header">
        <h5 class="card-title"><i class="bi bi-list-ul"></i>All lots<span class="count-chip">@Model.Count()</span></h5>
        <div class="grid-tools">
            <label class="grid-search"><i class="bi bi-search"></i><input type="search" placeholder="Search lots…" aria-label="Search lots" data-table-filter="#lots-grid" /></label>
            <a asp-action="Expiry" class="btn btn-outline-secondary btn-sm"><i class="bi bi-hourglass-split"></i>Expiring soon</a>
        </div>
    </div>
    <div class="table-responsive table-scroll" id="lots-grid"><partial name="_LotsTable" model="Model" /></div>
</div>