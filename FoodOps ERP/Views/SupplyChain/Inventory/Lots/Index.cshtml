@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Lot & Expiry Tracking";
    ViewData["Subtitle"] = "Track every lot, its quality status and expiry";
    ViewData["Mode"] = "lots";
}
<partial name="_PageHeader" />

<div class="card" id="grid-card">
    @Html.GridToolbar("Search lots…", "lots", Model.Count(), null, @<text>
        <a href="@Url.Action("Expiry")" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-hourglass-split"></i>Expiring soon
        </a>
    </text>)
<div class="table-scroll">
        <partial name="_LotsTable" model="Model" />
    </div>
</div>