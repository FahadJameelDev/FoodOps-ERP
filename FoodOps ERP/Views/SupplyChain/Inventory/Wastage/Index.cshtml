@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Inventory Wastage";
    ViewData["Subtitle"] = "Record spoilage, damage and losses against a lot";
    ViewData["Mode"] = "wastage";
}
<partial name="_PageHeader" />

<div class="card" id="grid-card">
    @Html.GridToolbar("Search lots…", "lots", Model.Count(), null, @<text>
        <a href="@Url.Action("Create")" class="btn btn-danger btn-sm"
               data-modal="true" data-modal-title="Record wastage" data-modal-size="md" data-modal-icon="bi-trash3">
            <i class="bi bi-plus-lg"></i>Record wastage
        </a>
    </text>)
<!-- ✅ FIX: Added style for horizontal scroll -->
<div class="table-scroll" style="overflow-x: auto;">
        <partial name="_LotsTable" model="Model" />
    </div>
</div>