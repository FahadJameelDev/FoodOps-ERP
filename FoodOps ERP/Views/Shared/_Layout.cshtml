@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    <title>@ViewData["Title"] - FoodOps ERP</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-wrapper">
        <partial name="_Sidebar" />

        <div class="main-content">
            <partial name="_Topbar" />

            @* Module tabs: shell.js khud bharta hai; dashboard par chhupa rehta hai *@
            <div class="subheader" hidden>
                <nav class="modnav" aria-label="Module navigation"></nav>
            </div>

            <main class="page-content" id="pageContent" role="main" tabindex="-1">
                @RenderBody()
            </main>

            <partial name="_Footer" />
        </div>
    </div>

    @if (TempData["Success"] is string okMsg)
    {
        <script>document.addEventListener('DOMContentLoaded',()=>window.showToast(@Json.Serialize(okMsg),'success'));</script>
    }
    @if (TempData["Error"] is string errMsg)
    {
        <script>document.addEventListener('DOMContentLoaded',()=>window.showToast(@Json.Serialize(errMsg),'error'));</script>
    }

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>

    <script src="~/js/ui.js" asp-append-version="true"></script>
    <script src="~/js/shell.js" asp-append-version="true"></script>
    <script src="~/js/spa-router.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>