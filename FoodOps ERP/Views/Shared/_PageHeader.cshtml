<div class="page-header">
    <div>
        <div class="page-title-row">
            <div class="page-title-icon"><i class="bi @(ViewData["Icon"] ?? "bi-grid")"></i></div>
            <h1 class="page-title">@ViewData["Title"]</h1>
        </div>
        @if (ViewData["Subtitle"] is string sub)
        {
            <p class="page-subtitle">@sub</p>
        }
    </div>
</div>