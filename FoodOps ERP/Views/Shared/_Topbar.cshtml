@using System.Security.Claims
@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var userEmail = isAuthenticated ? (User.FindFirst(ClaimTypes.Email)?.Value ?? User.Identity?.Name ?? "Guest") : "Guest";
    var userRole = isAuthenticated ? (User.FindFirst(ClaimTypes.Role)?.Value ?? (User.IsInRole("Admin") ? "System Admin" : "User")) : "Guest";
    var userInitial = !string.IsNullOrEmpty(userEmail) && userEmail != "Guest" ? userEmail.Substring(0, 1).ToUpper() : "G";
}

<style>
    /* ✅ FIX: Topbar Layout */
    .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 24px;
        gap: 24px;
    }

    .topbar-left {
        flex: 1;
        max-width: 100%;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .topbar-search {
        width: 100%;
        max-width: 100%;
    }

    .topbar-right {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-shrink: 0;
    }

    /* ✅ User Dropdown Premium Styling */
    .topbar-user {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 6px 12px;
        border-radius: 8px;
        cursor: pointer;
        text-decoration: none;
        transition: background 0.2s;
        border: 1px solid transparent;
    }

        .topbar-user:hover {
            background: var(--surface-2);
            border-color: var(--line);
        }

    /* ✅ Fix: Dropdown items ko premium banayein */
    .topbar-dropdown-menu {
        padding: 8px !important;
    }

        .topbar-dropdown-menu .dropdown-item {
            padding: 10px 12px !important;
            border-radius: 6px !important;
            font-size: 13px !important;
            font-weight: 500 !important;
            transition: all 0.15s !important;
        }

            .topbar-dropdown-menu .dropdown-item:hover {
                background: var(--surface-2) !important;
            }

    /* ✅ Notification Items Fix */
    .notification-item {
        padding: 12px !important;
        border-radius: 8px !important;
        transition: background 0.15s !important;
    }

        .notification-item:hover {
            background: var(--surface-2) !important;
        }
</style>

<header class="topbar" id="topbar" role="banner">

    <div class="topbar-left">
        <button type="button" class="btn-icon d-lg-none" id="mobileSidebarToggle" aria-label="Open navigation menu">
            <i class="bi bi-list" aria-hidden="true"></i>
        </button>

        <form class="topbar-search" method="get" asp-controller="Search" asp-action="Index" role="search" id="globalSearchForm">
            <i class="bi bi-search topbar-search-icon" aria-hidden="true"></i>
            <input type="search" name="q" id="globalSearch" placeholder="Search anything..." aria-label="Global search" autocomplete="off" />
            <kbd class="topbar-search-kbd d-none d-md-inline">⌘K</kbd>
            <button type="button" class="topbar-search-ai" title="Ask AI" aria-label="Ask AI" onclick="location.href='/AIAssistant'">
                <i class="bi bi-stars" aria-hidden="true"></i>
                <span class="d-none d-lg-inline">AI</span>
            </button>
        </form>
    </div>

    <div class="topbar-right">

        <!-- Notification Bell -->
        <div class="dropdown">
            <button type="button" class="btn-icon position-relative" data-bs-toggle="dropdown" data-bs-offset="0,12" aria-expanded="false" aria-label="Notifications">
                <i class="bi bi-bell" aria-hidden="true"></i>
                <span class="notification-badge">3</span>
            </button>

            <ul class="dropdown-menu dropdown-menu-end shadow border-0 topbar-dropdown-menu" style="min-width: 360px;">
                <!-- Header -->
                <li class="px-3 py-2 border-bottom d-flex justify-content-between align-items-center">
                    <strong class="fs-sm">Notifications</strong>
                    <a href="#" class="text-emerald fs-xs">Mark all read</a>
                </li>

                <!-- Real Notification Items -->
                <li>
                    <a class="notification-item d-flex gap-3 text-decoration-none" href="/Dashboard/Alerts">
                        <div class="bg-danger-subtle rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 36px; height: 36px;">
                            <i class="bi bi-exclamation-triangle text-danger"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="fw-semibold text-heading" style="font-size: 13px;">Material Shortage</div>
                            <div class="text-muted" style="font-size: 11px;">Sugar below reorder level</div>
                            <div class="text-light mt-1" style="font-size: 10px;">5 minutes ago</div>
                        </div>
                    </a>
                </li>
                <li>
                    <a class="notification-item d-flex gap-3 text-decoration-none" href="/IncomingQC">
                        <div class="bg-success-subtle rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 36px; height: 36px;">
                            <i class="bi bi-check-circle text-success"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="fw-semibold text-heading" style="font-size: 13px;">QC Inspection Passed</div>
                            <div class="text-muted" style="font-size: 11px;">Batch B-104 approved</div>
                            <div class="text-light mt-1" style="font-size: 10px;">20 minutes ago</div>
                        </div>
                    </a>
                </li>
                <li>
                    <a class="notification-item d-flex gap-3 text-decoration-none" href="/Payroll">
                        <div class="bg-info-subtle rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 36px; height: 36px;">
                            <i class="bi bi-info-circle text-info"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="fw-semibold text-heading" style="font-size: 13px;">Payroll Pending</div>
                            <div class="text-muted" style="font-size: 11px;">October payroll awaiting approval</div>
                            <div class="text-light mt-1" style="font-size: 10px;">1 hour ago</div>
                        </div>
                    </a>
                </li>

                <!-- Footer -->
                <li class="text-center py-2 border-top">
                    <a href="/AIAudit/Index" class="text-emerald fs-xs fw-semibold">View all notifications</a>
                </li>
            </ul>
        </div>

        <!-- User Profile Dropdown -->
        <div class="dropdown">
            <a href="#" class="topbar-user" data-bs-toggle="dropdown" data-bs-offset="0,12" aria-expanded="false" aria-label="User menu">
                <div class="user-avatar" aria-hidden="true">@userInitial</div>
                <div class="user-info d-none d-md-flex">
                    <span class="user-name">@userEmail</span>
                    <span class="user-role">@userRole</span>
                </div>
                <i class="bi bi-chevron-down text-muted ms-1 d-none d-md-inline" aria-hidden="true" style="font-size: 10px;"></i>
            </a>

            <ul class="dropdown-menu dropdown-menu-end shadow border-0 topbar-dropdown-menu" style="min-width: 280px;">
                <!-- Email header -->
                <li class="px-3 py-3 border-bottom">
                    <div class="fw-semibold text-heading" style="font-size: var(--fs-sm); word-break: break-all;">@userEmail</div>
                    <div class="text-muted" style="font-size: var(--fs-xs);">@userRole</div>
                </li>

                @if (isAuthenticated)
                {
                    <!-- Notifications shortcut -->
                    <li>
                        <a class="dropdown-item fs-sm d-flex align-items-center justify-content-between" href="/AIAudit/Index">
                            <span><i class="bi bi-bell me-2"></i>Notifications</span>
                            <span class="badge bg-danger">3</span>
                        </a>
                    </li>

                    <li><hr class="dropdown-divider"></li>

                    <!-- ✅ Real Logout (POST form with CSRF) -->
                    <li>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="dropdown-item fs-sm text-danger border-0 bg-transparent w-100 text-start d-flex align-items-center">
                                <i class="bi bi-box-arrow-right me-2"></i>Logout
                            </button>
                        </form>
                    </li>
                }
                else
                {
                    <li>
                        <a class="dropdown-item fs-sm" asp-controller="Account" asp-action="Login">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Login
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>
</header>