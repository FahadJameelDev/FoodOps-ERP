@model IEnumerable<dynamic>
@{
    var mode = ViewData["Mode"] as string ?? "lots";
}

@if (!Model.Any())
{
    <partial name="_EmptyState" model='"No lots found."' />
}
else
{
    <!-- ✅ FIX: min-width barha di taake text squeeze na ho -->
    <table class="table table-hover mb-0" style="min-width: 900px;">
        <thead>
            <tr>
                <th>Batch #</th>
                <th>Product</th>
                <th class="num">Quantity</th>
                <th>Expiry</th>
                <th>QC status</th>
                <th class="text-end" style="min-width: 120px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var lot in Model)
            {
                int? days = Fmt.DaysLeft(lot.ExpiryDate);
                <tr>
                    <td><span class="code">@lot.BatchNumber</span></td>
                    <td>@lot.ProductName</td>
                    <td class="num">@Fmt.Qty(lot.CurrentQuantity)</td>
                    <td>
                        @if (days is null)
                        {
                            <span class="na">—</span>
                        }
                        else
                        {
                            <span class="pill @Fmt.ExpiryClass(days)">@Fmt.ExpiryText(days)</span>
                            <small class="text-muted ms-1">@Fmt.Date(lot.ExpiryDate)</small>
                        }
                    </td>
                    <td><partial name="_StatusPill" model="lot.QCStatus" /></td>
                    <td class="text-end">
                        <div class="row-actions">
                            @if (mode == "issue")
                            {
                                <!-- ✅ FIX: Text hataya, Sirf Icon rakha taake katay na -->
                                <a asp-controller="MaterialIssue" asp-action="Create" asp-route-batchId="@lot.BatchID"
                                       class="btn btn-primary btn-sm" title="Issue material"
                                       data-modal="true" data-modal-title="Issue material" data-modal-size="md" data-modal-icon="bi-box-arrow-up">
                                    <i class="bi bi-box-arrow-up"></i>
                                </a>
                                <a asp-controller="MaterialIssue" asp-action="Return" asp-route-batchId="@lot.BatchID"
                                       class="btn btn-outline-secondary btn-sm" title="Return material"
                                       data-modal="true" data-modal-title="Return material" data-modal-size="md" data-modal-icon="bi-box-arrow-in-down">
                                    <i class="bi bi-box-arrow-in-down"></i>
                                </a>
                            }
                            else if (mode == "wastage")
                            {
                                <a asp-controller="Wastage" asp-action="Create" asp-route-batchId="@lot.BatchID"
                                       class="btn btn-outline-danger btn-sm" title="Record wastage"
                                       data-modal="true" data-modal-title="Record wastage" data-modal-size="md" data-modal-icon="bi-trash3">
                                    <i class="bi bi-trash3"></i>
                                </a>
                            }
                            else
                            {
                                <a asp-controller="Stock" asp-action="Adjust" asp-route-batchId="@lot.BatchID"
                                       class="btn btn-outline-secondary btn-sm" title="Adjust stock"
                                       data-modal="true" data-modal-title="Adjust stock" data-modal-size="md" data-modal-icon="bi-sliders">
                                    <i class="bi bi-sliders"></i>
                                </a>
                                @if (mode == "expiry")
                                {
                                    <a asp-controller="Wastage" asp-action="Create" asp-route-batchId="@lot.BatchID"
                                           class="btn btn-outline-danger btn-sm" title="Write off"
                                           data-modal="true" data-modal-title="Record wastage" data-modal-size="md" data-modal-icon="bi-trash3">
                                        <i class="bi bi-trash3"></i>
                                    </a>
                                }
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}