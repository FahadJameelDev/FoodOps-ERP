@model FoodOpsERP.Models.Executive.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "AI Assistant Hub";
    ViewData["Subtitle"] = "Intelligent insights across your factory";
}

<style>
    /* ✅ MICROSOFT FLUENT - SINGLE PAGE AI HUB */
    .page-content { padding: 12px var(--content-x) 12px var(--content-x) !important; overflow: hidden !important; }

    .ai-dashboard { 
        display: flex; 
        flex-direction: column; 
        gap: 12px; 
        height: 100%;
        min-height: 0;
    }

    /* Premium Header */
    .ai-header-card {
        display: flex; align-items: center; justify-content: space-between;
        background: #ffffff; border: 1px solid var(--border);
        border-radius: var(--radius-card); padding: 10px 16px; flex-shrink: 0;
    }
    .header-icon { display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; background: #F5F3FF; color: #7C3AED; border-radius: 8px; font-size: 18px; }
    .header-title { font-size: 18px; font-weight: 700; color: var(--text-heading); margin: 0; line-height: 1.2; }
    .header-subtitle { font-size: 11px; color: var(--text-muted); margin: 0; }

    /* Tiles Grid */
    .ai-tiles-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
        flex-shrink: 0;
    }

    .ai-tile {
        display: flex; align-items: center; gap: 16px; padding: 16px 20px;
        background: #fff; border: 1px solid var(--border); border-radius: var(--radius-card);
        text-decoration: none; color: var(--text-body);
        transition: all 0.2s;
        height: 80px;
    }
    .ai-tile:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(15, 23, 42, 0.08);
        border-color: #CBD5E1;
    }

    .tile-icon-wrapper {
        width: 40px; height: 40px; border-radius: 10px; flex-shrink: 0;
        display: flex; align-items: center; justify-content: center; font-size: 20px;
    }
    
    .tile-content { flex-grow: 1; min-width: 0; }
    .tile-title { font-size: 14px; font-weight: 700; color: var(--text-heading); margin: 0; white-space: nowrap; }
    .tile-desc { font-size: 11px; color: var(--text-muted); margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

    /* Chart Card */
    .chart-card {
        flex: 1;
        display: flex;
        flex-direction: column;
        background: #fff;
        border: 1px solid var(--border);
        border-radius: var(--radius-card);
        padding: 16px;
        min-height: 0;
    }
    .chart-card-header {
        display: flex; align-items: center; justify-content: space-between;
        margin-bottom: 8px; flex-shrink: 0;
    }
    .chart-card-title { font-size: 14px; font-weight: 600; color: var(--text-heading); margin: 0; display: flex; align-items: center; gap: 8px; }

    .chart-container { flex: 1; position: relative; min-height: 0; }
</style>

<div class="ai-dashboard">
    
    <!-- 1. HEADER -->
    <div class="ai-header-card">
        <div class="d-flex align-items-center gap-3">
            <div class="header-icon"><i class="bi bi-stars"></i></div>
            <div>
                <h1 class="header-title">AI Assistant Hub</h1>
                <p class="header-subtitle">Intelligent insights across your factory</p>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-surface-2 text-muted border px-3 py-2" style="font-size: 11px; border-radius: 6px; font-weight: 500;">
                <i class="bi bi-cpu text-ai"></i> AI Active
            </span>
        </div>
    </div>

    <!-- 2. TILES GRID -->
    <div class="ai-tiles-grid">
        <a asp-action="Inventory" class="ai-tile">
            <div class="tile-icon-wrapper" style="background: #ECFDF5; color: #059669;"><i class="bi bi-boxes"></i></div>
            <div class="tile-content">
                <h6 class="tile-title">Inventory Assistant</h6>
                <p class="tile-desc">Check stock, expiry alerts & reorder</p>
            </div>
        </a>

        <a asp-action="Production" class="ai-tile">
            <div class="tile-icon-wrapper" style="background: #EFF6FF; color: #2563EB;"><i class="bi bi-gear"></i></div>
            <div class="tile-content">
                <h6 class="tile-title">Production Assistant</h6>
                <p class="tile-desc">Batch status, efficiency & bottlenecks</p>
            </div>
        </a>

        <a asp-action="Quality" class="ai-tile">
            <div class="tile-icon-wrapper" style="background: #ECFDF5; color: #059669;"><i class="bi bi-patch-check"></i></div>
            <div class="tile-content">
                <h6 class="tile-title">Quality Assistant</h6>
                <p class="tile-desc">QC results, hold alerts & pass rates</p>
            </div>
        </a>

        <a asp-action="Cost" class="ai-tile">
            <div class="tile-icon-wrapper" style="background: #FEF3C7; color: #D97706;"><i class="bi bi-calculator"></i></div>
            <div class="tile-content">
                <h6 class="tile-title">Cost Assistant</h6>
                <p class="tile-desc">Variance analysis & budget tracking</p>
            </div>
        </a>

        <a asp-action="Payroll" class="ai-tile">
            <div class="tile-icon-wrapper" style="background: #FEF2F2; color: #DC2626;"><i class="bi bi-people"></i></div>
            <div class="tile-content">
                <h6 class="tile-title">Payroll Assistant</h6>
                <p class="tile-desc">Salary queries, attendance & overtime</p>
            </div>
        </a>

        <a asp-action="Management" class="ai-tile">
            <div class="tile-icon-wrapper" style="background: #EFF6FF; color: #2563EB;"><i class="bi bi-briefcase"></i></div>
            <div class="tile-content">
                <h6 class="tile-title">Management Assistant</h6>
                <p class="tile-desc">Factory overview & high-level summary</p>
            </div>
        </a>
    </div>

    <!-- ✅ 3. REAL DATA CHART -->
    <div class="chart-card">
        <div class="chart-card-header">
            <h5 class="chart-card-title"><i class="bi bi-bar-chart-fill text-primary"></i> Current Factory Metrics</h5>
            <span class="badge bg-surface-2 text-muted border px-3 py-2" style="font-size: 11px; border-radius: 6px; font-weight: 500;">
                <i class="bi bi-database text-primary"></i> Real Data
            </span>
        </div>
        <div class="chart-container">
            <canvas id="realDataChart"></canvas>
        </div>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    (function () {
        const canvas = document.getElementById('realDataChart');
        if (!canvas) return;
        const ctx = canvas.getContext('2d');
        
        // ✅ REAL DATA FROM YOUR MODEL
        const labels = ['Total Employees', 'Active Orders', 'Today Production', 'Quality Pass %'];
        
        const data = [
            @(Model?.TotalEmployees ?? 0), 
            @(Model?.ActiveProductionOrders ?? 0), 
            @(Model?.TodayProducedQty ?? 0), 
            @(Model?.QualityPassRate ?? 0)
        ];

        if (window.myRealChart instanceof Chart) {
            window.myRealChart.destroy();
        }

        window.myRealChart = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Current Value',
                    data: data,
                    backgroundColor: ['#10B981', '#3B82F6', '#8B5CF6', '#F59E0B'],
                    borderRadius: 6,
                    barThickness: 40
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { 
                    legend: { display: false },
                    tooltip: { backgroundColor: 'rgba(15, 23, 42, 0.9)', padding: 12 }
                },
                scales: {
                    y: { beginAtZero: true, grid: { color: '#F1F5F9' }, ticks: { color: '#64748B', font: { size: 11 } } },
                    x: { grid: { display: false }, ticks: { color: '#64748B', font: { size: 11 } } }
                }
            }
        });
    })();
</script>