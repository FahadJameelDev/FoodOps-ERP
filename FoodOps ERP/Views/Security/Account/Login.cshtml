@model FoodOpsERP.Models.Security.ViewModels.LoginViewModel
@{
    Layout = null; 
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Login — FoodOps ERP</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        body { 
            background: #0f172a; 
            min-height: 100vh; 
            display: flex; 
            align-items: center; 
            justify-content: center; 
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        }
        .login-card { 
            width: 100%; 
            max-width: 440px; 
            background: #1e293b; 
            border-radius: 16px; 
            padding: 2.25rem; 
            color: #e2e8f0; 
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5), 0 8px 10px -6px rgba(0, 0, 0, 0.5);
            border: 1px solid #334155;
        }
        .login-card h1 { 
            font-size: 1.65rem; 
            font-weight: 700;
            color: #10b981; 
            margin-bottom: 0.25rem; 
            letter-spacing: -0.02em;
        }
        .login-card .subtitle { 
            color: #94a3b8; 
            font-size: 0.875rem; 
            margin-bottom: 1.5rem; 
        }
        .form-control { 
            background: #0f172a; 
            border-color: #334155; 
            color: #f8fafc; 
            border-radius: 8px;
            padding: 0.625rem 0.875rem;
        }
        .form-control:focus { 
            background: #0f172a; 
            border-color: #10b981; 
            color: #f8fafc; 
            box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2); 
        }
        .btn-login { 
            background: #10b981; 
            border: none; 
            width: 100%; 
            padding: 0.65rem; 
            font-weight: 600; 
            border-radius: 8px;
            color: #022c22;
            transition: all 0.15s ease;
        }
        .btn-login:hover { 
            background: #059669; 
            color: #ffffff;
        }
        .text-danger { font-size: 0.8125rem; }

        /* Quick Demo Accounts Pills */
        .demo-section {
            margin-top: 1.5rem;
            padding-top: 1.25rem;
            border-top: 1px dashed #334155;
        }
        .demo-title {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #64748b;
            font-weight: 600;
            margin-bottom: 0.75rem;
        }
        .demo-badges {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
        }
        .demo-badge {
            background: #0f172a;
            border: 1px solid #334155;
            color: #cbd5e1;
            font-size: 0.75rem;
            padding: 4px 10px;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.15s ease;
        }
        .demo-badge:hover {
            border-color: #10b981;
            color: #10b981;
            background: #1e293b;
        }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="d-flex align-items-center gap-2 mb-1">
            <i class="bi bi-box-seam-fill text-emerald fs-4" style="color: #10b981;"></i>
            <h1 class="m-0">FoodOps ERP</h1>
        </div>
        <div class="subtitle">Sign in to access your role workspace</div>

        <form method="post" asp-action="Login">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Username" class="form-label text-slate-300 small fw-semibold">Username / Email</label>
                <input asp-for="Username" id="txtUsername" class="form-control" autofocus autocomplete="username" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label text-slate-300 small fw-semibold">Password</label>
                <input asp-for="Password" id="txtPassword" type="password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label small text-slate-400"></label>
            </div>

            <button type="submit" class="btn btn-login">
                <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
            </button>
        </form>

        <!-- Quick Switcher for Demo / Testing -->
        <div class="demo-section">
            <div class="demo-title"><i class="bi bi-lightning-charge-fill text-warning me-1"></i> Quick Demo Accounts</div>
            <div class="demo-badges">
                <button type="button" class="demo-badge" onclick="fillCreds('admin', 'admin123')">Admin</button>
                <button type="button" class="demo-badge" onclick="fillCreds('hr_manager', 'admin123')">HR</button>
                <button type="button" class="demo-badge" onclick="fillCreds('qc_inspector', 'admin123')">QC</button>
                <button type="button" class="demo-badge" onclick="fillCreds('store_manager', 'admin123')">Store</button>
                <button type="button" class="demo-badge" onclick="fillCreds('executive', 'admin123')">Exec</button>
                <button type="button" class="demo-badge" onclick="fillCreds('prod_manager', 'admin123')">Production</button>
                <button type="button" class="demo-badge" onclick="fillCreds('cost_accountant', 'admin123')">Costing</button>
                <button type="button" class="demo-badge" onclick="fillCreds('ai_assistant', 'admin123')">AI Bot</button>
            </div>
        </div>
    </div>

    <script>
        function fillCreds(user, pass) {
            document.getElementById('txtUsername').value = user;
            document.getElementById('txtPassword').value = pass;
        }
    </script>
</body>
</html>