@model List<FoodOpsERP.Models.Workforce.HRPayroll.ViewModels.OvertimeViewModel>
@{
    ViewData["Title"] = "Overtime";
    ViewData["Subtitle"] = "Overtime Management";
}
<partial name="_PageHeader" />

<div class="card" id="grid-card">
    @Html.GridToolbar("Search OT records...", "ot", Model.Count, "All|Pending|Approved|Rejected", @<text>
        <a href="@Url.Action("Create")" class="btn btn-primary btn-sm" data-modal="true" data-modal-title="New OT Record" data-modal-size="lg"><i class="bi bi-plus-lg"></i> New Overtime</a>
    </text>)

<div class="table-scroll">
        @if (Model.Any())
        {
            <table class="table table-hover mb-0">
                <thead><tr><th>Date</th><th>Employee</th><th class="num">Hours</th><th class="num">Multiplier</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.OTDate.ToString("dd MMM yyyy")</td>
                            <td><strong>@item.EmployeeName</strong></td>
                            <td class="num">@item.OTHours</td>
                            <td class="num">@item.OTRateMultiplier.ToString("N2")x</td>
                            <td><partial name="_StatusPill" model="item.Status" /></td>
                            <td class="text-end">
                                @if (item.Status == "Pending")
                                {
                                    <div class="row-actions">
                                        <button type="button" class="btn btn-sm btn-outline-success" data-action-url="@Url.Action("Approve", new { id = item.OvertimeID })" data-confirm-title="Approve OT?" data-confirm-text="Approve" data-refresh="#grid-card"><i class="bi bi-check"></i></button>
                                        <button type="button" class="btn btn-sm btn-outline-danger" data-action-url="@Url.Action("Reject", new { id = item.OvertimeID })" data-confirm-title="Reject OT?" data-confirm-text="Reject" data-refresh="#grid-card"><i class="bi bi-x"></i></button>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {

            <partial name="_EmptyState" model='"No overtime records found."' />
        }
    </div>
</div>