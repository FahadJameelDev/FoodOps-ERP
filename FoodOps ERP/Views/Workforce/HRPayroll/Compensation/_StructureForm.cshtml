@model FoodOpsERP.Models.Workforce.HRPayroll.ViewModels.SalaryStructureViewModel
@{
    var isEdit = Model.StructureID != 0;
}
<form asp-action="@(isEdit ? "EditStructure" : "CreateStructure")" asp-route-id="@(isEdit ? Model.StructureID.ToString() : null)" method="post" data-spa-form data-reload-url="@Url.Action("Index")" data-refresh="#grid-card" novalidate>
    <div class="fo-modal__body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        @if (isEdit)
        {
            <input type="hidden" asp-for="StructureID" />
        }

        <div class="row g-3">
            <div class="col-md-6"><label asp-for="StructureCode" class="form-label">Code</label><input asp-for="StructureCode" class="form-control" readonly="@isEdit" /></div>
            <div class="col-md-6"><label asp-for="StructureName" class="form-label">Name</label><input asp-for="StructureName" class="form-control" /></div>
            
            <div class="col-md-6"><label asp-for="BasicSalary" class="form-label">Basic Salary</label><input asp-for="BasicSalary" type="number" step="0.01" class="form-control num" /></div>
            <div class="col-md-6"><label asp-for="HousingAllowance" class="form-label">Housing Allowance</label><input asp-for="HousingAllowance" type="number" step="0.01" class="form-control num" /></div>
            
            <div class="col-md-6"><label asp-for="TransportAllowance" class="form-label">Transport Allowance</label><input asp-for="TransportAllowance" type="number" step="0.01" class="form-control num" /></div>
            <div class="col-md-6"><label asp-for="OtherAllowance" class="form-label">Other Allowance</label><input asp-for="OtherAllowance" type="number" step="0.01" class="form-control num" /></div>
            
            <div class="col-12"><div class="form-check mt-3"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">Is Active</label></div></div>
        </div>
    </div>
    <div class="fo-modal__footer">
        <button type="button" class="btn btn-outline-secondary" data-modal-close>Cancel</button>
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i><span>@(isEdit ? "Update" : "Save")</span></button>
    </div>
</form>