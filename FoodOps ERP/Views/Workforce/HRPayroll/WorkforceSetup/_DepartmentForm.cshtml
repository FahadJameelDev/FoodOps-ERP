@model FoodOpsERP.Models.Workforce.HRPayroll.ViewModels.DepartmentViewModel
@{
    var isEdit = Model.DepartmentID != 0;
}

<form asp-action="@(isEdit ? "EditDepartment" : "CreateDepartment")" asp-route-id="@(isEdit ? Model.DepartmentID.ToString() : null)"
      method="post" data-spa-form data-reload-url="@Url.Action("Index")" data-refresh="#grid-card" novalidate>
    <div class="fo-modal__body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        @if (isEdit)
        {
            <input type="hidden" asp-for="DepartmentID" />
        }

        <div class="row g-3">
            <div class="col-md-12">
                <label asp-for="PlantID" class="form-label">Plant <span class="text-danger">*</span></label>
                <!-- ✅ Updated: asp-items Model se -->
                <select asp-for="PlantID" asp-items="Model.PlantList" class="form-select">
                    <option value="">Select Plant...</option>
                </select>
            </div>
            <div class="col-md-6">
                <label asp-for="DepartmentCode" class="form-label">Code <span class="text-danger">*</span></label>
                <input asp-for="DepartmentCode" class="form-control" readonly="@isEdit" />
            </div>
            <div class="col-md-6">
                <label asp-for="DepartmentName" class="form-label">Name <span class="text-danger">*</span></label>
                <input asp-for="DepartmentName" class="form-control" />
            </div>
            <div class="col-md-6">
                <div class="form-check mt-3">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label">Is Active</label>
                </div>
            </div>
        </div>
    </div>
    <div class="fo-modal__footer">
        <button type="button" class="btn btn-outline-secondary" data-modal-close>Cancel</button>
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i><span>@(isEdit ? "Update" : "Save")</span></button>
    </div>
</form>