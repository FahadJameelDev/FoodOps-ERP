@model FoodOpsERP.Models.Workforce.HRPayroll.ViewModels.PayrollViewModel
@{
    ViewData["Title"] = "Approve Payroll";
    ViewData["Subtitle"] = $"Approve run {Model.RunNo}";
}
<partial name="_PageHeader" />

<div class="card">
    <div class="card-body">
        <form asp-action="Approve" asp-route-id="@Model.PayrollRunID" method="post">
            <div class="mb-3">
                <label class="form-label">Comments</label>
                <textarea name="comments" class="form-control" rows="3" placeholder="Enter approval remarks..." required></textarea>
            </div>
            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Details" asp-route-id="@Model.PayrollRunID" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-success"><i class="bi bi-check-lg"></i> Approve Payroll</button>
            </div>
        </form>
    </div>
</div>