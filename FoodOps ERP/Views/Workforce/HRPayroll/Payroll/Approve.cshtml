@model FoodOpsERP.Models.Workforce.HRPayroll.ViewModels.PayrollViewModel
@{
    ViewData["Title"] = "Approve Payroll";
    ViewData["Subtitle"] = $"Approve run {Model.RunNo}";
}

<style>
    .page-content { padding: 12px var(--content-x) 12px var(--content-x) !important; }

    .approve-dashboard {
        display: flex;
        flex-direction: column;
        gap: 12px;
        height: calc(100vh - 140px);
    }

    /* Header */
    .approve-header-card {
        display: flex; align-items: center; justify-content: space-between;
        background: #ffffff; border: 1px solid var(--border);
        border-radius: var(--radius-card); padding: 12px 16px; flex-shrink: 0;
    }
    .header-icon { display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; background: #ECFDF5; color: #059669; border-radius: 8px; font-size: 18px; }
    .header-title { font-size: 18px; font-weight: 700; color: var(--text-heading); margin: 0; line-height: 1.2; }
    .header-subtitle { font-size: 11px; color: var(--text-muted); margin: 0; }

    /* Form Card */
    .form-card {
        flex: 1;
        background: #fff; border: 1px solid var(--border); border-radius: var(--radius-card);
        display: flex; flex-direction: column; min-height: 0;
    }
    .form-card-header { padding: 12px 16px; border-bottom: 1px solid var(--divider); flex-shrink: 0; }
    .form-card-title { font-size: 15px; font-weight: 600; color: var(--text-heading); margin: 0; display: flex; align-items: center; gap: 8px; }
    
    .form-card-body { padding: 24px; flex: 1; overflow-y: auto; }

    .form-label { font-size: 12px; font-weight: 600; color: var(--text-heading); margin-bottom: 8px; }
    .form-control { border-radius: 8px; border: 1px solid var(--line-strong); padding: 12px 16px; font-size: 14px; background: var(--surface-2); }
    .form-control:focus { outline: none; background: #fff; border-color: var(--emerald); box-shadow: 0 0 0 3px var(--emerald-glow); }

    .form-card-footer {
        padding: 16px 24px; border-top: 1px solid var(--divider); flex-shrink: 0;
        display: flex; justify-content: flex-end; gap: 12px; background: #F8FAFC;
        border-radius: 0 0 var(--radius-card) var(--radius-card);
    }
</style>

<div class="approve-dashboard">
    <!-- 1. Header -->
    <div class="approve-header-card">
        <div class="d-flex align-items-center gap-3">
            <div class="header-icon"><i class="bi bi-check-circle"></i></div>
            <div>
                <h1 class="header-title">Approve Payroll</h1>
                <p class="header-subtitle">Approve run @Model.RunNo - @Model.PeriodMonth/@Model.PeriodYear</p>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a asp-action="Details" asp-route-id="@Model.PayrollRunID" class="btn btn-outline-secondary btn-sm py-2 px-3" style="font-size: 12px;">
                <i class="bi bi-arrow-left me-1"></i> Back to Details
            </a>
        </div>
    </div>

    <!-- 2. Form Card -->
    <div class="form-card">
        <div class="form-card-header">
            <h5 class="form-card-title"><i class="bi bi-pencil-square"></i> Approval Comments</h5>
        </div>
        <form asp-action="Approve" asp-route-id="@Model.PayrollRunID" method="post" class="d-flex flex-column flex-grow-1" style="min-height: 0;">
            <div class="form-card-body">
                <div class="mb-3">
                    <label class="form-label">Comments <span class="text-danger">*</span></label>
                    <textarea name="comments" class="form-control" rows="6" placeholder="Enter approval remarks here... (e.g., All calculations verified, approved for finalization)" required></textarea>
                    <small class="text-muted mt-2 d-block">These comments will be logged for audit purposes.</small>
                </div>
            </div>
            <div class="form-card-footer">
                <a asp-action="Details" asp-route-id="@Model.PayrollRunID" class="btn btn-outline-secondary py-2 px-4" style="font-size: 13px;">Cancel</a>
                <button type="submit" class="btn btn-success py-2 px-4" style="font-size: 13px;"><i class="bi bi-check-lg me-1"></i> Approve Payroll</button>
            </div>
        </form>
    </div>
</div>