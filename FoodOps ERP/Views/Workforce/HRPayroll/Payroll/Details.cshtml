@model FoodOpsERP.Models.Workforce.HRPayroll.ViewModels.PayrollViewModel
@{
    ViewData["Title"] = $"Payroll {Model.RunNo}";
    ViewData["Subtitle"] = $"{Model.PeriodMonth}/{Model.PeriodYear} - {Model.PlantName}";
}

<style>
    .page-content { padding: 12px var(--content-x) 12px var(--content-x) !important; }

    .payroll-dashboard {
        display: flex;
        flex-direction: column;
        gap: 12px;
        height: calc(100vh - 140px);
    }

    /* Premium Header */
    .payroll-header-card {
        display: flex; align-items: center; justify-content: space-between;
        background: #ffffff; border: 1px solid var(--border);
        border-radius: var(--radius-card); padding: 12px 16px; flex-shrink: 0;
    }
    .header-icon { display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; background: #EFF6FF; color: #2563EB; border-radius: 8px; font-size: 18px; }
    .header-title { font-size: 18px; font-weight: 700; color: var(--text-heading); margin: 0; line-height: 1.2; }
    .header-subtitle { font-size: 11px; color: var(--text-muted); margin: 0; }

    /* Summary Stats Grid (Replaces flat text) */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: 12px;
        flex-shrink: 0;
    }
    .stat-box {
        background: #fff; border: 1px solid var(--border); border-radius: var(--radius-card);
        padding: 16px; display: flex; flex-direction: column; gap: 4px;
    }
    .stat-label { font-size: 11px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.03em; }
    .stat-value { font-size: 16px; font-weight: 700; color: var(--text-heading); line-height: 1.2; }

    /* Table Card */
    .table-card {
        flex: 1;
        background: #fff; border: 1px solid var(--border); border-radius: var(--radius-card);
        display: flex; flex-direction: column; overflow: hidden; min-height: 0;
    }
    .table-card-header {
        padding: 12px 16px; border-bottom: 1px solid var(--divider); flex-shrink: 0;
        display: flex; align-items: center; justify-content: space-between;
    }
    .table-card-title { font-size: 15px; font-weight: 600; color: var(--text-heading); margin: 0; display: flex; align-items: center; gap: 8px; }

    .table-body-scroll { flex: 1; overflow-y: auto; min-height: 0; }
    .premium-table { width: 100%; border-collapse: separate; border-spacing: 0; margin: 0; }
    .premium-table th {
        background: var(--surface-2); color: var(--text-muted); font-size: 11px; font-weight: 600;
        text-transform: uppercase; letter-spacing: 0.05em; padding: 12px 16px;
        text-align: left; border-bottom: 1px solid var(--line); position: sticky; top: 0; z-index: 2;
    }
    .premium-table td {
        padding: 12px 16px; font-size: 13px; color: var(--text-body);
        border-bottom: 1px solid var(--divider); vertical-align: middle;
    }
    .premium-table tr:last-child td { border-bottom: none; }
    .premium-table tr:hover td { background: var(--surface-2); }
</style>

<div class="payroll-dashboard">
    <!-- 1. Premium Header -->
    <div class="payroll-header-card">
        <div class="d-flex align-items-center gap-3">
            <div class="header-icon"><i class="bi bi-file-earmark-text"></i></div>
            <div>
                <h1 class="header-title">Payroll @Model.RunNo <partial name="_StatusPill" model="Model.Status" /></h1>
                <p class="header-subtitle">@Model.PeriodMonth/@Model.PeriodYear - @Model.PlantName</p>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm py-2 px-3" style="font-size: 12px;">
                <i class="bi bi-arrow-left me-1"></i> Back
            </a>
            @if (Model.Status == "Draft")
            {
                <form method="post" asp-action="Calculate" asp-route-id="@Model.PayrollRunID" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-primary btn-sm py-2 px-3" style="font-size: 12px;"><i class="bi bi-calculator me-1"></i> Calculate</button>
                </form>
            }
            @if (Model.Status == "Calculated")
            {
                <form method="post" asp-action="Approve" asp-route-id="@Model.PayrollRunID" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="comments" value="Approved from details page" />
                    <button type="submit" class="btn btn-success btn-sm py-2 px-3" style="font-size: 12px;"><i class="bi bi-check-circle me-1"></i> Approve</button>
                </form>
            }
            @if (Model.Status == "Approved")
            {
                <form method="post" asp-action="Finalize" asp-route-id="@Model.PayrollRunID" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-secondary btn-sm py-2 px-3" style="font-size: 12px;"><i class="bi bi-lock me-1"></i> Finalize</button>
                </form>
            }
        </div>
    </div>

    <!-- 2. Summary Stats (Premium Grid) -->
    <div class="stats-grid">
        <div class="stat-box">
            <span class="stat-label">Total Employees</span>
            <span class="stat-value">@Model.TotalEmployees</span>
        </div>
        <div class="stat-box">
            <span class="stat-label">Total Basic Pay</span>
            <span class="stat-value">@Model.TotalBasicPay.ToString("N2")</span>
        </div>
        <div class="stat-box">
            <span class="stat-label">Total Allowances</span>
            <span class="stat-value">@Model.TotalAllowances.ToString("N2")</span>
        </div>
        <div class="stat-box">
            <span class="stat-label">Total OT Pay</span>
            <span class="stat-value">@Model.TotalOvertimePay.ToString("N2")</span>
        </div>
        <div class="stat-box">
            <span class="stat-label">Total Deductions</span>
            <span class="stat-value text-danger">@Model.TotalDeductions.ToString("N2")</span>
        </div>
        <div class="stat-box" style="background: #F0FDF4; border-color: #BBF7D0;">
            <span class="stat-label text-success">Net Payable</span>
            <span class="stat-value text-success" style="font-size: 20px;">@Model.NetPayable.ToString("N2")</span>
        </div>
    </div>

    <!-- 3. Table Card -->
    <div class="table-card">
        <div class="table-card-header">
            <h5 class="table-card-title"><i class="bi bi-list-check"></i> Employee Payroll Lines</h5>
            <span class="badge bg-surface-2 text-muted border px-3 py-2" style="font-size: 12px; border-radius: 6px;">
                @(Model.Lines?.Count() ?? 0) Employees
            </span>
        </div>
        <div class="table-body-scroll">
            <table class="premium-table">
                <thead>
                    <tr>
                        <th>Employee</th>
                        <th class="text-end">Basic</th>
                        <th class="text-end">Allowances</th>
                        <th class="text-end">OT Pay</th>
                        <th class="text-end">Deductions</th>
                        <th class="text-end">Net Pay</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Lines != null && Model.Lines.Any())
                    {
                        foreach (var line in Model.Lines)
                        {
                            <tr>
                                <td><strong>@line.EmployeeName</strong></td>
                                <td class="text-end">@line.BasicPay.ToString("N2")</td>
                                <td class="text-end">@((line.HousingAllowance + line.TransportAllowance + line.OtherAllowance).ToString("N2"))</td>
                                <td class="text-end">@line.OvertimePay.ToString("N2")</td>
                                <td class="text-end text-danger">@line.TotalDeductions.ToString("N2")</td>
                                <td class="text-end text-success fw-bold">@line.NetPay.ToString("N2")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">No lines generated. Click Calculate to generate.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>