@model List<FoodOpsERP.Models.Workforce.HRPayroll.ViewModels.EmployeeViewModel>
@{
    ViewData["Title"] = "Employees";
    ViewData["Subtitle"] = "Employee Management";
}

<partial name="_PageHeader" />

<div class="card" id="grid-card">
    @Html.GridToolbar("Search employees...", "employees", Model.Count, "All|Active|Inactive", @<text>
        <a href="@Url.Action("Create")" class="btn btn-primary btn-sm" data-modal="true" data-modal-title="New Employee" data-modal-size="xl"><i class="bi bi-plus-lg"></i> New Employee</a>
    </text>)

<div class="table-scroll">
        @if (Model.Any())
        {
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Department</th>
                        <th>Designation</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="code">@item.EmployeeCode</span></td>
                            <td>@item.FirstName @item.LastName</td>
                            <td>@item.DepartmentName</td>
                            <td>@item.Designation</td>
                            <td><partial name="_StatusPill" model='item.IsActive ? "Active" : "Inactive"' /></td>
                            <td class="text-end">
                                <div class="row-actions">
                                    <a href="@Url.Action("Edit", new { id = item.EmployeeID })" class="btn btn-sm btn-outline-secondary" data-modal="true" data-modal-title="Edit Employee" data-modal-size="xl"><i class="bi bi-pencil"></i></a>
                                    <button type="button" class="btn btn-sm btn-outline-danger" data-action-url="@Url.Action("ToggleActive", new { id = item.EmployeeID })" data-name="@item.EmployeeCode" data-confirm-title="Toggle Status?" data-confirm-text="Toggle" data-refresh="#grid-card"><i class="bi bi-power"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {

            <partial name="_EmptyState" model='"No employees found. Click New Employee to create one."' />
        }
    </div>
</div>