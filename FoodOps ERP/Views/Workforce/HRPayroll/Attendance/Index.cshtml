@model List<FoodOpsERP.Models.Workforce.HRPayroll.ViewModels.AttendanceViewModel>
@{
    ViewData["Title"] = "Attendance";
    ViewData["Subtitle"] = "Daily Attendance Logs";
}
<partial name="_PageHeader" />

<div class="card" id="grid-card">
    @Html.GridToolbar("Search attendance...", "attendance", Model.Count, null, @<text>
        <a href="@Url.Action("Corrections")" class="btn btn-outline-secondary btn-sm"><i class="bi bi-wrench"></i> Corrections</a>
        <a href="@Url.Action("Create")" class="btn btn-primary btn-sm" data-modal="true" data-modal-title="Record Attendance" data-modal-size="lg"><i class="bi bi-plus-lg"></i> Record</a>
    </text>)

<div class="table-scroll">
        @if (Model.Any())
        {
            <table class="table table-hover mb-0">
                <thead><tr><th>Date</th><th>Employee</th><th>In</th><th>Out</th><th class="num">Worked (Min)</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.LogDate.ToString("dd MMM yyyy")</td>
                            <td><strong>@item.EmployeeName</strong></td>
                            <td>@(item.CheckInTime?.ToString("HH:mm") ?? "—")</td>
                            <td>@(item.CheckOutTime?.ToString("HH:mm") ?? "—")</td>
                            <td class="num">@(item.WorkedMinutes?.ToString() ?? "—")</td>
                            <td><partial name="_StatusPill" model="item.Status" /></td>
                            <td class="text-end">
                                <a href="@Url.Action("Edit", new { id = item.AttendanceID })" class="btn btn-sm btn-outline-secondary" data-modal="true" data-modal-title="Edit Attendance" data-modal-size="lg"><i class="bi bi-pencil"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {

            <partial name="_EmptyState" model='"No attendance records found."' />
        }
    </div>
</div>