@model List<FoodOpsERP.Models.Workforce.HRPayroll.ViewModels.AttendanceCorrectionViewModel>
@{
    ViewData["Title"] = "Attendance Corrections";
    ViewData["Subtitle"] = "Fix missing punches";
}
<partial name="_PageHeader" />

<div class="card" id="grid-card">
    @Html.GridToolbar("Search corrections...", "corrections", Model.Count, "All|Pending|Approved|Rejected", @<text>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Attendance</a>
        <a href="@Url.Action("CreateCorrection")" class="btn btn-primary btn-sm" data-modal="true" data-modal-title="New Correction" data-modal-size="lg"><i class="bi bi-plus-lg"></i> Request Correction</a>
    </text>)

<div class="table-scroll">
        @if (Model.Any())
        {
            <table class="table table-hover mb-0">
                <thead><tr><th>Date</th><th>Employee</th><th>Reason</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@(item.LogDate?.ToString("dd MMM yyyy") ?? "—")</td>
                            <td>@item.EmployeeName</td>
                            <td class="text-truncate" style="max-width: 200px;">@item.Reason</td>
                            <td><partial name="_StatusPill" model="item.Status" /></td>
                            <td class="text-end">
                                @if (item.Status == "Pending")
                                {
                                    <div class="row-actions">
                                        <button type="button" class="btn btn-sm btn-outline-success" data-action-url="@Url.Action("ApproveCorrection", new { id = item.CorrectionID })" data-confirm-title="Approve Correction?" data-confirm-text="Approve" data-refresh="#grid-card"><i class="bi bi-check"></i></button>
                                        <button type="button" class="btn btn-sm btn-outline-danger" data-action-url="@Url.Action("RejectCorrection", new { id = item.CorrectionID })" data-confirm-title="Reject Correction?" data-confirm-text="Reject" data-refresh="#grid-card"><i class="bi bi-x"></i></button>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {

            <partial name="_EmptyState" model='"No corrections found."' />
        }
    </div>
</div>