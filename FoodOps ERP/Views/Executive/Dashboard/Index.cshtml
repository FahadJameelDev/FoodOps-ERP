@model FoodOpsERP.Models.Executive.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Executive Dashboard";
    ViewData["Subtitle"] = "Factory Overview & KPIs";
}

<partial name="_PageHeader" />

<!-- 1. Factory Overview & KPIs Grid -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card kpi-card">
            <div class="kpi-header">
                <div class="kpi-title">Employees</div>
                <div class="kpi-icon kpi-emerald"><i class="bi bi-people"></i></div>
            </div>
            <div class="kpi-value">@Model.TotalEmployees</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card kpi-card">
            <div class="kpi-header">
                <div class="kpi-title">Active Prod. Orders</div>
                <div class="kpi-icon kpi-amber"><i class="bi bi-gear"></i></div>
            </div>
            <div class="kpi-value">@Model.ActiveProductionOrders</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card kpi-card">
            <div class="kpi-header">
                <div class="kpi-title">Today's Production</div>
                <div class="kpi-icon kpi-emerald"><i class="bi bi-box-seam"></i></div>
            </div>
            <div class="kpi-value">@Model.TodayProducedQty.ToString("N0")</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card kpi-card">
            <div class="kpi-header">
                <div class="kpi-title">Quality Pass Rate</div>
                <div class="kpi-icon kpi-emerald"><i class="bi bi-patch-check"></i></div>
            </div>
            <div class="kpi-value">@Model.QualityPassRate.ToString("N1")%</div>
        </div>
    </div>
</div>

<div class="row g-3">
    <!-- 9. Trends Chart -->
    <div class="col-lg-8">
        <div class="card h-100">
            <div class="card-header"><h5 class="card-title"><i class="bi bi-graph-up"></i>Production Trend (Last 7 Days)</h5></div>
            <div class="card-body">
                <canvas id="productionChart" height="100"></canvas>
            </div>
        </div>
    </div>

    <!-- 7. Critical Alerts & 8. Action Queue -->
    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-header"><h5 class="card-title text-danger"><i class="bi bi-exclamation-triangle"></i>Critical Alerts</h5></div>
            <div class="card-body p-2">
                @if (Model.CriticalAlerts.Any())
                {
                    foreach (var alert in Model.CriticalAlerts)
                    {
                        <div class="alert-item alert-item-@(alert.Severity == "Critical" ? "danger" : "warning") mb-2">
                            <div class="alert-item-icon"><i class="bi bi-exclamation-circle"></i></div>
                            <div class="alert-item-content">
                                <div class="alert-item-title">@alert.Title</div>
                                <div class="alert-item-desc">@alert.Description</div>
                            </div>
                            <a href="@alert.Link" class="alert-item-action">View</a>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted text-center py-3">No critical alerts.</p>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header"><h5 class="card-title"><i class="bi bi-list-task"></i>Action Queue</h5></div>
            <div class="card-body p-2">
                @if (Model.ActionQueue.Any())
                {
                    foreach (var action in Model.ActionQueue)
                    {
                        <div class="alert-item alert-item-info mb-2">
                            <div class="alert-item-icon"><i class="bi bi-clock"></i></div>
                            <div class="alert-item-content">
                                <div class="alert-item-title">@action.Task</div>
                            </div>
                            <a href="@action.Link" class="alert-item-action">Go</a>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted text-center py-3">No pending actions.</p>
                }
            </div>
        </div>
    </div>
</div>

<!-- 10. AI Summary -->
<div class="card mt-3">
    <div class="card-header"><h5 class="card-title text-primary"><i class="bi bi-robot"></i>AI Summary</h5></div>
    <div class="card-body">
        <p class="mb-0 text-muted">@Model.AiSummary</p>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const ctx = document.getElementById('productionChart').getContext('2d');
        new Chart(ctx, {
        type: 'line',
        data: {
        labels: @Json.Serialize(Model.ProductionTrend.Select(x => x.Label)),
        datasets: [{
        label: 'Production Qty',
        data: @Json.Serialize(Model.ProductionTrend.Select(x => x.Value)),
        borderColor: '#10B981',
        backgroundColor: 'rgba(16, 185, 129, 0.1)',
        fill: true,
        tension: 0.4
        }]
        },
        options: {
        responsive: true,
        plugins: { legend: { display: false } },
        scales: { y: { beginAtZero: true } }
        }
        });
    </script>
}