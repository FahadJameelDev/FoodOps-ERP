@model FoodOpsERP.Models.Executive.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Cost KPIs";
    ViewData["Subtitle"] = "Detailed Cost & Variance Metrics";
}
<partial name="_PageHeader" />
<div class="card">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-6"><span class="text-muted d-block fs-xs">Total Batch Cost (Month)</span><b>@Model.TotalBatchCostThisMonth.ToString("N2")</b></div>
            <div class="col-md-6"><span class="text-muted d-block fs-xs">Total Variance (Month)</span><b class="text-danger">@Model.TotalVarianceThisMonth.ToString("N2")</b></div>
        </div>
    </div>
</div>