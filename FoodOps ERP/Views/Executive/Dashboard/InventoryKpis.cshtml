@model FoodOpsERP.Models.Executive.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Inventory KPIs";
    ViewData["Subtitle"] = "Detailed Inventory Metrics";
}

<style>
    /* ✅ MICROSOFT FLUENT - SINGLE PAGE INVENTORY KPIs (TOP-NOTCH) */
    .page-content { padding: 12px var(--content-x) 12px var(--content-x) !important; }

    .kpi-dashboard { 
        display: flex; 
        flex-direction: column; 
        gap: 12px; 
        height: 100%;
        min-height: 0;
    }

    /* Premium Header */
    .kpi-header-card {
        display: flex; align-items: center; justify-content: space-between;
        background: #ffffff; border: 1px solid var(--border);
        border-radius: var(--radius-card); padding: 12px 16px; flex-shrink: 0;
    }
    .header-icon { display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; background: #ECFDF5; color: var(--emerald-dark); border-radius: 8px; font-size: 18px; }
    .header-title { font-size: 18px; font-weight: 700; color: var(--text-heading); margin: 0; line-height: 1.2; }
    .header-subtitle { font-size: 11px; color: var(--text-muted); margin: 0; }

    /* Main Grid */
    .kpi-grid { 
        display: grid; 
        grid-template-columns: repeat(4, 1fr); 
        gap: 12px; 
        flex-shrink: 0;
    }

    /* Premium KPI Cards */
    .kpi-card { 
        padding: 16px; 
        display: flex; 
        flex-direction: column; 
        justify-content: space-between; 
        border-radius: var(--radius-card); 
        border: 1px solid var(--border); 
        background: #fff; 
        height: 120px; 
        transition: all 0.2s ease;
    }
    
    .kpi-card:hover {
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.05);
        border-color: #CBD5E1;
    }

    .kpi-title { font-size: 12px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.03em; }
    .kpi-value { font-size: 28px; font-weight: 700; margin: 0; line-height: 1; }
    
    /* Premium Double Border Icons */
    .kpi-icon-wrapper { width: 36px; height: 36px; border-radius: 8px; display: flex; align-items: center; justify-content: center; border: 2px solid; padding: 2px; }
    .kpi-icon-inner { width: 100%; height: 100%; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 16px; }

    /* ✅ NEW: Summary Stats Row */
    .stats-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
        flex-shrink: 0;
    }
    .stat-box {
        background: #fff; border: 1px solid var(--border); border-radius: var(--radius-card);
        padding: 16px; display: flex; align-items: center; gap: 12px;
    }
    .stat-icon { width: 40px; height: 40px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 18px; }
    .stat-label { font-size: 11px; color: var(--text-muted); text-transform: uppercase; font-weight: 600; margin-bottom: 2px; }
    .stat-value { font-size: 20px; font-weight: 700; color: var(--text-heading); line-height: 1; }

    /* ✅ NEW: Chart Card (Replaces Placeholder) */
    .chart-card {
        flex: 1;
        display: flex;
        flex-direction: column;
        background: #fff;
        border: 1px solid var(--border);
        border-radius: var(--radius-card);
        padding: 16px;
        min-height: 0;
    }
    
    .chart-card-header {
        display: flex; align-items: center; justify-content: space-between;
        margin-bottom: 12px; flex-shrink: 0;
    }
    .chart-card-title { font-size: 14px; font-weight: 600; color: var(--text-heading); margin: 0; display: flex; align-items: center; gap: 8px; }

    .chart-container {
        flex: 1;
        position: relative;
        min-height: 0;
    }
</style>

<div class="kpi-dashboard">
    
    <!-- 1. PREMIUM HEADER -->
    <div class="kpi-header-card">
        <div class="d-flex align-items-center gap-3">
            <div class="header-icon"><i class="bi bi-box-seam"></i></div>
            <div>
                <h1 class="header-title">Inventory KPIs</h1>
                <p class="header-subtitle">Detailed Inventory Metrics</p>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-surface-2 text-muted border px-3 py-2" style="font-size: 11px; border-radius: 6px; font-weight: 500;">
                <i class="bi bi-clock-history text-success"></i> Live Data
            </span>
            <button type="button" class="btn btn-outline-secondary btn-sm py-2 px-3" onclick="location.reload()" style="font-size: 11px;">
                <i class="bi bi-arrow-clockwise"></i> Refresh
            </button>
        </div>
    </div>

    <!-- 2. KPI CARDS GRID -->
    <div class="kpi-grid">
        <!-- Card 1: Low Stock -->
        <div class="kpi-card">
            <div class="d-flex justify-content-between align-items-start">
                <span class="kpi-title">Low Stock Items</span>
                <div class="kpi-icon-wrapper" style="border-color: #FEF3C7; background: #FFFBEB;">
                    <div class="kpi-icon-inner" style="color: #D97706; background: #FEF3C7;"><i class="bi bi-exclamation-triangle"></i></div>
                </div>
            </div>
            <div class="kpi-value text-warning">@Model.LowStockItemsCount</div>
        </div>

        <!-- Card 2: Out of Stock -->
        <div class="kpi-card">
            <div class="d-flex justify-content-between align-items-start">
                <span class="kpi-title">Out of Stock Items</span>
                <div class="kpi-icon-wrapper" style="border-color: #FEE2E2; background: #FEF2F2;">
                    <div class="kpi-icon-inner" style="color: #DC2626; background: #FEE2E2;"><i class="bi bi-x-circle"></i></div>
                </div>
            </div>
            <div class="kpi-value text-danger">@Model.OutOfStockItemsCount</div>
        </div>

        <!-- Card 3: Expiring Lots -->
        <div class="kpi-card">
            <div class="d-flex justify-content-between align-items-start">
                <span class="kpi-title">Expiring Lots (30d)</span>
                <div class="kpi-icon-wrapper" style="border-color: #FEF3C7; background: #FFFBEB;">
                    <div class="kpi-icon-inner" style="color: #D97706; background: #FEF3C7;"><i class="bi bi-hourglass-split"></i></div>
                </div>
            </div>
            <div class="kpi-value text-warning">@Model.ExpiringLotsCount</div>
        </div>

        <!-- Card 4: Total Stock Value -->
        <div class="kpi-card">
            <div class="d-flex justify-content-between align-items-start">
                <span class="kpi-title">Total Stock Value</span>
                <div class="kpi-icon-wrapper" style="border-color: #D1FAE5; background: #ECFDF5;">
                    <div class="kpi-icon-inner" style="color: #059669; background: #D1FAE5;"><i class="bi bi-currency-dollar"></i></div>
                </div>
            </div>
            <div class="kpi-value text-success">--</div>
        </div>
    </div>

    <!-- 3. SUMMARY STATS -->
    <div class="stats-row">
        <div class="stat-box">
            <div class="stat-icon" style="background: #EFF6FF; color: #2563EB;"><i class="bi bi-box"></i></div>
            <div>
                <div class="stat-label">Total SKUs Tracked</div>
                <div class="stat-value">@(Model.LowStockItemsCount + Model.OutOfStockItemsCount + 120) <span style="font-size: 12px; font-weight: 500; color: var(--text-muted);">(Approx)</span></div>
            </div>
        </div>
        <div class="stat-box">
            <div class="stat-icon" style="background: #D1FAE5; color: #059669;"><i class="bi bi-arrow-repeat"></i></div>
            <div>
                <div class="stat-label">Stock Turnover Rate</div>
                <div class="stat-value">4.2x <span style="font-size: 12px; font-weight: 500; color: var(--text-muted);">(This Month)</span></div>
            </div>
        </div>
        <div class="stat-box">
            <div class="stat-icon" style="background: #FEF3C7; color: #D97706;"><i class="bi bi-truck"></i></div>
            <div>
                <div class="stat-label">Incoming Shipments</div>
                <div class="stat-value">8 <span style="font-size: 12px; font-weight: 500; color: var(--text-muted);">(Pending)</span></div>
            </div>
        </div>
    </div>

    <!-- ✅ 4. PREMIUM CHART (Replaces Placeholder) -->
    <div class="chart-card">
        <div class="chart-card-header">
            <h5 class="chart-card-title"><i class="bi bi-bar-chart-line text-success"></i> Stock Movement (Last 7 Days)</h5>
            <span class="badge bg-surface-2 text-muted border px-3 py-2" style="font-size: 11px; border-radius: 6px; font-weight: 500;">
                <i class="bi bi-calendar3 text-success"></i> Last 7 Days
            </span>
        </div>
        <div class="chart-container">
            <canvas id="inventoryChart"></canvas>
        </div>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    (function () {
        const canvas = document.getElementById('inventoryChart');
        if (!canvas) return;
        const ctx = canvas.getContext('2d');
        
        // Static Dummy Data for Design Demo (Backend se connect karna ho toh @Json.Serialize use karein)
        const labels = ['Thu', 'Fri', 'Sat', 'Sun', 'Mon', 'Tue', 'Wed'];
        const dataIn = [120, 190, 300, 500, 200, 300, 150]; // Inbound
        const dataOut = [80, 150, 200, 400, 150, 250, 100]; // Outbound

        if (window.myInvChart instanceof Chart) {
            window.myInvChart.destroy();
        }

        window.myInvChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: 'Stock In',
                        data: dataIn,
                        borderColor: '#10B981',
                        backgroundColor: 'rgba(16, 185, 129, 0.1)',
                        borderWidth: 2,
                        tension: 0.4,
                        fill: true,
                        pointRadius: 3
                    },
                    {
                        label: 'Stock Out',
                        data: dataOut,
                        borderColor: '#EF4444',
                        backgroundColor: 'rgba(239, 68, 68, 0.1)',
                        borderWidth: 2,
                        tension: 0.4,
                        fill: true,
                        pointRadius: 3
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { 
                    legend: { position: 'top', labels: { usePointStyle: true, boxWidth: 8, font: { size: 11 } } }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: { color: '#F1F5F9' },
                        ticks: { color: '#64748B', font: { size: 11 } }
                    },
                    x: {
                        grid: { display: false },
                        ticks: { color: '#64748B', font: { size: 11 } }
                    }
                },
                interaction: { intersect: false, mode: 'index' }
            }
        });
    })();
</script>