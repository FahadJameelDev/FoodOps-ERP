@model FoodOpsERP.Models.Executive.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Inventory KPIs";
    ViewData["Subtitle"] = "Detailed Inventory Metrics";
}
<partial name="_PageHeader" />
<div class="card">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4"><span class="text-muted d-block fs-xs">Low Stock Items</span><b class="text-warning">@Model.LowStockItemsCount</b></div>
            <div class="col-md-4"><span class="text-muted d-block fs-xs">Out of Stock Items</span><b class="text-danger">@Model.OutOfStockItemsCount</b></div>
            <div class="col-md-4"><span class="text-muted d-block fs-xs">Expiring Lots (30 days)</span><b class="text-warning">@Model.ExpiringLotsCount</b></div>
        </div>
    </div>
</div>