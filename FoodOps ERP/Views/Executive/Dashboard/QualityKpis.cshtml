@model FoodOpsERP.Models.Executive.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Quality KPIs";
    ViewData["Subtitle"] = "Detailed Quality Metrics";
}

<style>
    /* ✅ MICROSOFT FLUENT - SINGLE PAGE QUALITY KPIs (TOP-NOTCH) */
    .page-content { padding: 12px var(--content-x) 12px var(--content-x) !important; }

    .kpi-dashboard { 
        display: flex; 
        flex-direction: column; 
        gap: 12px; 
        height: 100%;
        min-height: 0;
    }

    /* Premium Header */
    .kpi-header-card {
        display: flex; align-items: center; justify-content: space-between;
        background: #ffffff; border: 1px solid var(--border);
        border-radius: var(--radius-card); padding: 12px 16px; flex-shrink: 0;
    }
    .header-icon { display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; background: #ECFDF5; color: var(--emerald-dark); border-radius: 8px; font-size: 18px; }
    .header-title { font-size: 18px; font-weight: 700; color: var(--text-heading); margin: 0; line-height: 1.2; }
    .header-subtitle { font-size: 11px; color: var(--text-muted); margin: 0; }

    /* Main Grid */
    .kpi-grid { 
        display: grid; 
        grid-template-columns: repeat(4, 1fr); 
        gap: 12px; 
        flex-shrink: 0;
    }

    /* Premium KPI Cards */
    .kpi-card { 
        padding: 16px; 
        display: flex; 
        flex-direction: column; 
        justify-content: space-between; 
        border-radius: var(--radius-card); 
        border: 1px solid var(--border); 
        background: #fff; 
        height: 120px; 
        transition: all 0.2s ease;
    }
    
    .kpi-card:hover {
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.05);
        border-color: #CBD5E1;
    }

    .kpi-title { font-size: 12px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.03em; }
    .kpi-value { font-size: 28px; font-weight: 700; margin: 0; line-height: 1; }
    
    /* Premium Double Border Icons */
    .kpi-icon-wrapper { width: 36px; height: 36px; border-radius: 8px; display: flex; align-items: center; justify-content: center; border: 2px solid; padding: 2px; }
    .kpi-icon-inner { width: 100%; height: 100%; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 16px; }

    /* ✅ NEW: Summary Stats Row */
    .stats-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
        flex-shrink: 0;
    }
    .stat-box {
        background: #fff; border: 1px solid var(--border); border-radius: var(--radius-card);
        padding: 16px; display: flex; align-items: center; gap: 12px;
    }
    .stat-icon { width: 40px; height: 40px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 18px; }
    .stat-label { font-size: 11px; color: var(--text-muted); text-transform: uppercase; font-weight: 600; margin-bottom: 2px; }
    .stat-value { font-size: 20px; font-weight: 700; color: var(--text-heading); line-height: 1; }

    /* ✅ NEW: Chart Card (Replaces Placeholder) */
    .chart-card {
        flex: 1;
        display: flex;
        flex-direction: column;
        background: #fff;
        border: 1px solid var(--border);
        border-radius: var(--radius-card);
        padding: 16px;
        min-height: 0;
    }
    
    .chart-card-header {
        display: flex; align-items: center; justify-content: space-between;
        margin-bottom: 12px; flex-shrink: 0;
    }
    .chart-card-title { font-size: 14px; font-weight: 600; color: var(--text-heading); margin: 0; display: flex; align-items: center; gap: 8px; }

    .chart-container {
        flex: 1;
        position: relative;
        min-height: 0;
    }
</style>

<div class="kpi-dashboard">
    
    <!-- 1. PREMIUM HEADER -->
    <div class="kpi-header-card">
        <div class="d-flex align-items-center gap-3">
            <div class="header-icon"><i class="bi bi-patch-check"></i></div>
            <div>
                <h1 class="header-title">Quality KPIs</h1>
                <p class="header-subtitle">Detailed Quality Metrics</p>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-surface-2 text-muted border px-3 py-2" style="font-size: 11px; border-radius: 6px; font-weight: 500;">
                <i class="bi bi-clock-history text-success"></i> Live Data
            </span>
            <button type="button" class="btn btn-outline-secondary btn-sm py-2 px-3" onclick="location.reload()" style="font-size: 11px;">
                <i class="bi bi-arrow-clockwise"></i> Refresh
            </button>
        </div>
    </div>

    <!-- 2. KPI CARDS GRID -->
    <div class="kpi-grid">
        <!-- Card 1: Pending Inspections -->
        <div class="kpi-card">
            <div class="d-flex justify-content-between align-items-start">
                <span class="kpi-title">Pending Inspections</span>
                <div class="kpi-icon-wrapper" style="border-color: #E0E7FF; background: #EEF2FF;">
                    <div class="kpi-icon-inner" style="color: #4F46E5; background: #E0E7FF;"><i class="bi bi-clipboard-check"></i></div>
                </div>
            </div>
            <div class="kpi-value" style="color: #4F46E5;">@Model.PendingQCInspections</div>
        </div>

        <!-- Card 2: Batches on Hold -->
        <div class="kpi-card">
            <div class="d-flex justify-content-between align-items-start">
                <span class="kpi-title">Batches on Hold</span>
                <div class="kpi-icon-wrapper" style="border-color: #FEE2E2; background: #FEF2F2;">
                    <div class="kpi-icon-inner" style="color: #DC2626; background: #FEE2E2;"><i class="bi bi-pause-circle"></i></div>
                </div>
            </div>
            <div class="kpi-value text-danger">@Model.QCOnHoldBatches</div>
        </div>

        <!-- Card 3: Quality Pass Rate -->
        <div class="kpi-card">
            <div class="d-flex justify-content-between align-items-start">
                <span class="kpi-title">Quality Pass Rate</span>
                <div class="kpi-icon-wrapper" style="border-color: #D1FAE5; background: #ECFDF5;">
                    <div class="kpi-icon-inner" style="color: #059669; background: #D1FAE5;"><i class="bi bi-check-circle"></i></div>
                </div>
            </div>
            <div class="kpi-value text-success">@Model.QualityPassRate.ToString("N1")%</div>
        </div>

        <!-- Card 4: Total Inspections -->
        <div class="kpi-card">
            <div class="d-flex justify-content-between align-items-start">
                <span class="kpi-title">Total Inspections</span>
                <div class="kpi-icon-wrapper" style="border-color: #DBEAFE; background: #EFF6FF;">
                    <div class="kpi-icon-inner" style="color: #2563EB; background: #DBEAFE;"><i class="bi bi-bar-chart"></i></div>
                </div>
            </div>
            <div class="kpi-value text-primary">--</div>
        </div>
    </div>

    <!-- 3. SUMMARY STATS -->
    <div class="stats-row">
        <div class="stat-box">
            <div class="stat-icon" style="background: #EFF6FF; color: #2563EB;"><i class="bi bi-clipboard-data"></i></div>
            <div>
                <div class="stat-label">Inspections This Month</div>
                <div class="stat-value">145 <span style="font-size: 12px; font-weight: 500; color: var(--text-muted);">(Total)</span></div>
            </div>
        </div>
        <div class="stat-box">
            <div class="stat-icon" style="background: #D1FAE5; color: #059669;"><i class="bi bi-check2-all"></i></div>
            <div>
                <div class="stat-label">Avg. Pass Rate</div>
                <div class="stat-value">@Model.QualityPassRate.ToString("N1")%</div>
            </div>
        </div>
        <div class="stat-box">
            <div class="stat-icon" style="background: #FEF3C7; color: #D97706;"><i class="bi bi-hourglass-split"></i></div>
            <div>
                <div class="stat-label">Avg. Decision Time</div>
                <div class="stat-value">4.2 <span style="font-size: 12px; font-weight: 500; color: var(--text-muted);">(hrs)</span></div>
            </div>
        </div>
    </div>

    <!-- ✅ 4. PREMIUM CHART (Replaces Placeholder) -->
    <div class="chart-card">
        <div class="chart-card-header">
            <h5 class="chart-card-title"><i class="bi bi-graph-up text-success"></i> Quality Pass Rate Trend (Last 7 Days)</h5>
            <span class="badge bg-surface-2 text-muted border px-3 py-2" style="font-size: 11px; border-radius: 6px; font-weight: 500;">
                <i class="bi bi-calendar3 text-success"></i> Last 7 Days
            </span>
        </div>
        <div class="chart-container">
            <canvas id="qualityChart"></canvas>
        </div>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    (function () {
        const canvas = document.getElementById('qualityChart');
        if (!canvas) return;
        const ctx = canvas.getContext('2d');
        
        // Dummy Data for Design Demo
        const labels = ['Thu', 'Fri', 'Sat', 'Sun', 'Mon', 'Tue', 'Wed'];
        const passRate = [98, 99, 95, 100, 97, 99, 100]; // Pass Rate (%)

        // Gradient for area chart
        let gradient = ctx.createLinearGradient(0, 0, 0, 400);
        gradient.addColorStop(0, 'rgba(16, 185, 129, 0.4)'); 
        gradient.addColorStop(1, 'rgba(16, 185, 129, 0.01)'); 

        if (window.myQualityChart instanceof Chart) {
            window.myQualityChart.destroy();
        }

        window.myQualityChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Pass Rate (%)',
                    data: passRate,
                    borderColor: '#10B981',
                    borderWidth: 3,
                    backgroundColor: gradient,
                    fill: true,
                    tension: 0.4,
                    pointBackgroundColor: '#fff',
                    pointBorderColor: '#10B981',
                    pointBorderWidth: 2,
                    pointRadius: 5,
                    pointHoverRadius: 7
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { 
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: 'rgba(15, 23, 42, 0.9)',
                        padding: 12,
                        titleFont: { size: 13, weight: 'bold' },
                        bodyFont: { size: 12 },
                        displayColors: false,
                        callbacks: {
                            label: function(context) {
                                return 'Pass Rate: ' + context.parsed.y + '%';
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        max: 100, // Ensure graph scales to 100
                        grid: { color: '#F1F5F9' },
                        ticks: { color: '#64748B', font: { size: 11 }, callback: function(value) { return value + '%'; } }
                    },
                    x: {
                        grid: { display: false },
                        ticks: { color: '#64748B', font: { size: 11 } }
                    }
                },
                interaction: {
                    intersect: false,
                    mode: 'index',
                },
            }
        });
    })();
</script>