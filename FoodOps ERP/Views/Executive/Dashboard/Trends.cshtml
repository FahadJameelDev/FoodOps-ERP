@model FoodOpsERP.Models.Executive.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Trends";
    ViewData["Subtitle"] = "Historical Data";
}
<partial name="_PageHeader" />
<div class="card">
    <div class="card-body">
        <canvas id="trendChart" height="100"></canvas>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const ctx = document.getElementById('trendChart').getContext('2d');
        new Chart(ctx, {
        type: 'bar',
        data: {
        labels: @Json.Serialize(Model.ProductionTrend.Select(x => x.Label)),
        datasets: [{
        label: 'Production Qty',
        data: @Json.Serialize(Model.ProductionTrend.Select(x => x.Value)),
        backgroundColor: '#10B981'
        }]
        },
        options: { responsive: true, plugins: { legend: { display: false } } }
        });
    </script>
}