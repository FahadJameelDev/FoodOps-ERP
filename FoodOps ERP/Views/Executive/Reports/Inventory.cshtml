@model FoodOpsERP.Models.Executive.ViewModels.ReportResultViewModel
@{
    ViewData["Title"] = "Inventory Report";
    ViewData["Subtitle"] = $"{Model.StartDate:dd MMM yyyy} to {Model.EndDate:dd MMM yyyy}";
}

<style>
    /* ✅ MICROSOFT FLUENT - PREMIUM INVENTORY REPORT */
    .page-content { padding: 12px var(--content-x) 12px var(--content-x) !important; }

    .report-dashboard { 
        display: flex; 
        flex-direction: column; 
        gap: 12px; 
        height: 100%;
        min-height: 0;
    }

    /* Premium Header */
    .report-header-card {
        display: flex; align-items: center; justify-content: space-between;
        background: #ffffff; border: 1px solid var(--border);
        border-radius: var(--radius-card); padding: 12px 16px; flex-shrink: 0;
    }
    .header-icon { display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; background: #ECFDF5; color: var(--emerald-dark); border-radius: 8px; font-size: 18px; }
    .header-title { font-size: 18px; font-weight: 700; color: var(--text-heading); margin: 0; line-height: 1.2; }
    .header-subtitle { font-size: 11px; color: var(--text-muted); margin: 0; }

    /* Table Card */
    .table-card {
        flex: 1;
        display: flex;
        flex-direction: column;
        background: #fff;
        border: 1px solid var(--border);
        border-radius: var(--radius-card);
        overflow: hidden;
        min-height: 0;
    }

    .table-card-header {
        display: flex; align-items: center; justify-content: space-between;
        padding: 12px 16px; border-bottom: 1px solid var(--divider); flex-shrink: 0;
    }
    .table-card-title { font-size: 15px; font-weight: 600; color: var(--text-heading); margin: 0; display: flex; align-items: center; gap: 8px; }

    /* Premium Table */
    .premium-table { width: 100%; border-collapse: separate; border-spacing: 0; margin: 0; }
    .premium-table th {
        background: var(--surface-2); color: var(--text-muted); font-size: 11px; font-weight: 600;
        text-transform: uppercase; letter-spacing: 0.05em; padding: 12px 16px;
        text-align: left; border-bottom: 1px solid var(--line); position: sticky; top: 0; z-index: 2;
    }
    .premium-table td {
        padding: 14px 16px; font-size: 13px; color: var(--text-body);
        border-bottom: 1px solid var(--divider); vertical-align: middle;
    }
    .premium-table tr:last-child td { border-bottom: none; }
    .premium-table tr:hover td { background: var(--surface-2); }

    /* Scrollable Body */
    .table-body-scroll { flex: 1; overflow-y: auto; min-height: 0; }

    /* Status Badges */
    .status-badge {
        display: inline-flex; align-items: center; padding: 4px 10px; border-radius: 12px;
        font-size: 11px; font-weight: 600;
    }
    .status-passed { background: #ECFDF5; color: #059669; }
    .status-failed { background: #FEF2F2; color: #DC2626; }
    .status-hold { background: #FEF3C7; color: #D97706; }
</style>

<div class="report-dashboard">
    
    <!-- 1. PREMIUM HEADER -->
    <div class="report-header-card">
        <div class="d-flex align-items-center gap-3">
            <div class="header-icon"><i class="bi bi-box-seam"></i></div>
            <div>
                <h1 class="header-title">Inventory Report</h1>
                <p class="header-subtitle">@Model.StartDate.ToString("dd MMM yyyy") to @Model.EndDate.ToString("dd MMM yyyy")</p>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm py-2 px-3" style="font-size: 12px;">
                <i class="bi bi-arrow-left me-1"></i> Back to Reports
            </a>
        </div>
    </div>

    <!-- 2. TABLE CARD -->
    <div class="table-card">
        <div class="table-card-header">
            <h5 class="table-card-title"><i class="bi bi-boxes"></i> Inventory Data</h5>
            <span class="badge bg-surface-2 text-muted border px-3 py-2" style="font-size: 11px; border-radius: 6px; font-weight: 500;">
                @Model.Rows.Count() Records
            </span>
        </div>
        
        <div class="table-body-scroll">
            @if (Model.Rows.Any())
            {
                <table class="premium-table">
                    <thead>
                        <tr>
                            @foreach (var h in Model.Headers)
                            {
                                <th>@h</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            <tr>
                                @for (int i = 0; i < row.Count(); i++)
                                {
                                    var cell = row.ElementAt(i);
                                    var header = Model.Headers.ElementAtOrDefault(i);
                                    
                                    // ✅ Special styling for QC Status
                                    if (header != null && (header.Contains("QC", StringComparison.OrdinalIgnoreCase) || header.Contains("Status", StringComparison.OrdinalIgnoreCase)))
                                    {
                                        var statusStr = cell?.ToString()?.ToLower() ?? "";
                                        var statusClass = statusStr switch {
                                            "passed" or "active" => "status-passed",
                                            "failed" or "rejected" => "status-failed",
                                            "hold" or "quarantine" => "status-hold",
                                            _ => "status-hold"
                                        };
                                        <td><span class="status-badge @statusClass">@cell</span></td>
                                    }
                                    else
                                    {
                                        <td>@cell</td>
                                    }
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="d-flex flex-column align-items-center justify-content-center h-100 py-5">
                    <i class="bi bi-inbox text-muted" style="font-size: 48px;"></i>
                    <h5 class="mt-3 text-heading" style="font-size: 16px; font-weight: 600;">No Data Found</h5>
                    <p class="text-muted mb-0" style="font-size: 13px;">No inventory records found for the selected date range.</p>
                </div>
            }
        </div>
    </div>

</div>