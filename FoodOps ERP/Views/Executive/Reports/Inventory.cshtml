@model FoodOpsERP.Models.Executive.ViewModels.ReportResultViewModel
@{
    ViewData["Title"] = "Inventory Report";
    ViewData["Subtitle"] = $"{Model.StartDate:dd MMM yyyy} to {Model.EndDate:dd MMM yyyy}";
}
<partial name="_PageHeader" />
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="card-title"><i class="bi bi-box-seam"></i>Inventory Report</h5>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i>Back</a>
    </div>
    <div class="table-scroll">
        @if (Model.Rows.Any())
        {
            <table class="table table-hover mb-0">
                <thead><tr>@foreach (var h in Model.Headers) {
                    <th>@h</th>
                }
            </tr></thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr>@foreach (var cell in row) {
                        <td>@cell</td>
                    }
                </tr>
            }
        </tbody>
    </table>
}
        else
{

    <partial name="_EmptyState" model='"No inventory data found."' />
}
</div>
</div>