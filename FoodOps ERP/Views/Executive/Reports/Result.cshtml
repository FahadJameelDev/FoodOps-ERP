@model FoodOpsERP.Models.Executive.ViewModels.ReportResultViewModel
@{
    ViewData["Title"] = Model.ReportTitle;
    ViewData["Subtitle"] = $"{Model.StartDate:dd MMM yyyy} to {Model.EndDate:dd MMM yyyy}";
}
<partial name="_PageHeader" />

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="card-title"><i class="bi bi-table"></i>@Model.ReportTitle</h5>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i>Back</a>
    </div>
    <div class="table-scroll">
        @if (Model.Rows.Any())
        {
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        @foreach (var header in Model.Headers)
                        {
                            <th>@header</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            @foreach (var cell in row)
                            {
                                <td>@cell</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <partial name="_EmptyState" model='"No data found for this period."' />
        }
    </div>
</div>